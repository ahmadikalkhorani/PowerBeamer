                                    GridSwatch { swatch_color: #ca7d00; is_selected: root.active_color == #ca7d00; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #b69a00; is_selected: root.active_color == #b69a00; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #82a800; is_selected: root.active_color == #82a800; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #34a800; is_selected: root.active_color == #34a800; clicked(c) => { root.select_color_internal(c); } }
