                                    GridSwatch { swatch_color: #e3efff; is_selected: root.active_color == #e3efff; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #ece3ff; is_selected: root.active_color == #ece3ff; clicked(c) => { root.select_color_internal(c); } }
