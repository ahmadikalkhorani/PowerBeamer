                                    GridSwatch { swatch_color: #7bff47; is_selected: root.active_color == #7bff47; clicked(c) => { root.select_color_internal(c); } }
                                }

                                // Row 6: Soft pastels
                                HorizontalLayout {
                                    spacing: 0px;
                                    GridSwatch { swatch_color: #7adcff; is_selected: root.active_color == #7adcff; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #85bcff; is_selected: root.active_color == #85bcff; clicked(c) => { root.select_color_internal(c); } }
