                        }

                        // Tab 1: Wheel / Spectrum View
                        // Tab 1: Wheel (Interactive Circular Color Wheel)
                        if root.color_tab_index == 1: Rectangle {
                            height: 180px;
                            border-radius: 12px;
                            background: #141416;
                            border-width: 1px;
                            border-color: #27272a;
                            clip: true;

                            VerticalLayout {
                                padding-top: 8px;
                                padding-bottom: 8px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                // The Circular Color Wheel Disc
                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 120px;
                                        height: 120px;

                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: @image-url("color_wheel.png");
                                            image-fit: contain;
                                        }

                                        // Wheel selector indicator ring
                                        Rectangle {
                                            x: root.wheel_thumb_x - 8px;
                                            y: root.wheel_thumb_y - 8px;
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            border-width: 2.5px;
                                            border-color: #ffffff;
                                            background: root.active_color;
                                            drop-shadow-blur: 6px;
                                            drop-shadow-color: #000000cc;
                                        }

                                        wheel_touch := TouchArea {
                                            mouse-cursor: crosshair;
                                            moved => {
                                                if (self.pressed) {
                                                    root.color_wheel_touched(self.mouse-x, self.mouse-y);
                                                }
                                            }
                                            clicked => {
                                                root.color_wheel_touched(self.mouse-x, self.mouse-y);
                                            }
                                        }
                                    }
                                }

                                // Brightness / Value Slider
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "☀️";
                                        font-size: 12px;
                                        color: #71717a;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        width: 180px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: root.wheel_pure_color;
                                        border-width: 1px;
                                        border-color: #3f3f46;
                                        clip: true;

                                        // Black-to-transparent overlay producing exact brightness gradient
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            background: @linear-gradient(90deg, #000000 0%, transparent 100%);
                                        }

                                        // Slider thumb
                                        Rectangle {
                                            x: max(0px, min(parent.width - 16px, (parent.width - 16px) * root.wheel_val));
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            border-width: 2.5px;
                                            border-color: #ffffff;
                                            background: root.active_color;
                                            drop-shadow-blur: 5px;
                                            drop-shadow-color: #000000dd;
                                        }

                                        slider_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            moved => {
                                                if (self.pressed) {
                                                    let ratio = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                                                    root.color_brightness_touched(ratio);
                                                }
                                            }
                                            clicked => {
                                                let ratio = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                                                root.color_brightness_touched(ratio);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 2: Thematic Palettes
                        if root.color_tab_index == 2: Rectangle {
                            height: 180px;
                            border-radius: 12px;
                            background: #141416;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text { text: "Thematic Palettes"; font-size: 12px; color: #9ca3af; font-weight: 600; }

                                // Academic Beamer
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Academic:"; font-size: 11px; color: #6b7280; width: 60px; vertical-alignment: center; }
                                    GridSwatch { swatch_color: #002147; is_selected: root.active_color == #002147; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #800000; is_selected: root.active_color == #800000; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #004d40; is_selected: root.active_color == #004d40; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #e65100; is_selected: root.active_color == #e65100; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #4a148c; is_selected: root.active_color == #4a148c; clicked(c) => { root.select_color_internal(c); } }
                                }

                                // Neon Presenter
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Neon:"; font-size: 11px; color: #6b7280; width: 60px; vertical-alignment: center; }
                                    GridSwatch { swatch_color: #ff0055; is_selected: root.active_color == #ff0055; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #00e5ff; is_selected: root.active_color == #00e5ff; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #ffe600; is_selected: root.active_color == #ffe600; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #76ff03; is_selected: root.active_color == #76ff03; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #d500f9; is_selected: root.active_color == #d500f9; clicked(c) => { root.select_color_internal(c); } }
                                }

                                // Pastel Note
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Pastel:"; font-size: 11px; color: #6b7280; width: 60px; vertical-alignment: center; }
                                    GridSwatch { swatch_color: #ffccd5; is_selected: root.active_color == #ffccd5; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #caffbf; is_selected: root.active_color == #caffbf; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #9bf6ff; is_selected: root.active_color == #9bf6ff; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #a0c4ff; is_selected: root.active_color == #a0c4ff; clicked(c) => { root.select_color_internal(c); } }
                                    GridSwatch { swatch_color: #bdb2ff; is_selected: root.active_color == #bdb2ff; clicked(c) => { root.select_color_internal(c); } }
                                }
                            }
                        }

                        // Tab 3: Style
                        if root.color_tab_index == 3: Rectangle {
                            height: 180px;
                            border-radius: 12px;
                            background: #141416;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text { text: "Active Color Preview"; font-size: 12px; color: #9ca3af; font-weight: 600; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Rectangle {
                                        width: 50px;
                                        height: 50px;
                                        border-radius: 25px;
                                        background: root.active_color;
                                        border-width: 2px;
                                        border-color: #ffffff;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: "Current Drawing Color"; font-size: 13px; font-weight: 600; color: #ffffff; }
                                        Text { text: "Applied to Pen and Highlighter"; font-size: 11px; color: #9ca3af; }
                                    }
                                }

                                Text { text: "Stroke Width Quick Select:"; font-size: 12px; color: #9ca3af; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 76px; height: 30px; border-radius: 6px; background: root.stroke_width == 2px ? #007aff : #27272a;
                                        Text { text: "2px Fine"; color: #ffffff; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.stroke_width = 2px; root.width_changed(2px); } }
                                    }
                                    Rectangle {
                                        width: 86px; height: 30px; border-radius: 6px; background: root.stroke_width == 4px ? #007aff : #27272a;
                                        Text { text: "4px Medium"; color: #ffffff; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.stroke_width = 4px; root.width_changed(4px); } }
                                    }
                                    Rectangle {
                                        width: 76px; height: 30px; border-radius: 6px; background: root.stroke_width == 7px ? #007aff : #27272a;
                                        Text { text: "7px Bold"; color: #ffffff; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.stroke_width = 7px; root.width_changed(7px); } }
                                    }
                                }
                            }
                        }

                        // Palette Section (matches screenshot: "Palette", circles, (+) button)
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Palette";
                                font-size: 14px;
                                font-weight: 600;
                                color: #ffffff;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                for pal_col[i] in root.custom_palette: Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    background: transparent;

                                    // Same-color glow aura when active
                                    if root.active_color == pal_col: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: pal_col.transparentize(0.55);
                                        drop-shadow-blur: 10px;
                                        drop-shadow-color: pal_col;
                                    }

                                    // The Color Swatch Circle
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: (root.active_color == pal_col) ? 24px : 20px;
                                        height: (root.active_color == pal_col) ? 24px : 20px;
                                        border-radius: self.width / 2;
                                        background: pal_col;
                                        drop-shadow-blur: (root.active_color == pal_col) ? 8px : 0px;
                                        drop-shadow-color: pal_col;
                                        border-width: (root.active_color == pal_col) ? 2px : 0px;
                                        border-color: #ffffff;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.select_color_internal(pal_col);
                                        }
                                    }
                                }

                                // Circular Add (+) button
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: btn_add_pal.has-hover ? #374151 : #27272a;
                                    border-width: 1px;
                                    border-color: #3f3f46;

                                    Text {
                                        text: "+";
                                        font-size: 18px;
                                        font-weight: 600;
                                        color: btn_add_pal.has-hover ? #60a5fa : #38bdf8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    btn_add_pal := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.add_custom_color(root.active_color);
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Segmented Tab Bar: [ Grid | Wheel | Palettes | Style ]
                        Rectangle {
                            height: 32px;
                            border-radius: 8px;
                            background: #2a2a2e;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 1px;

                                // Tab 0: Grid
                                Rectangle {
                                    border-radius: 6px;
                                    background: root.color_tab_index == 0 ? #48484a : transparent;
                                    Text {
                                        text: "Grid";
                                        color: root.color_tab_index == 0 ? #ffffff : #8e8e93;
                                        font-size: 12px;
                                        font-weight: root.color_tab_index == 0 ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.color_tab_index = 0; }
                                    }
                                }

                                Rectangle { width: 1px; height: 16px; y: 6px; background: #3a3a3c; }

                                // Tab 1: Wheel
                                Rectangle {
                                    border-radius: 6px;
                                    background: root.color_tab_index == 1 ? #48484a : transparent;
                                    Text {
                                        text: "Wheel";
                                        color: root.color_tab_index == 1 ? #ffffff : #8e8e93;
                                        font-size: 12px;
                                        font-weight: root.color_tab_index == 1 ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.color_tab_index = 1; }
                                    }
                                }

                                Rectangle { width: 1px; height: 16px; y: 6px; background: #3a3a3c; }

                                // Tab 2: Palettes
                                Rectangle {
                                    border-radius: 6px;
                                    background: root.color_tab_index == 2 ? #48484a : transparent;
                                    Text {
                                        text: "Palettes";
                                        color: root.color_tab_index == 2 ? #ffffff : #8e8e93;
                                        font-size: 12px;
                                        font-weight: root.color_tab_index == 2 ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.color_tab_index = 2; }
                                    }
                                }

                                Rectangle { width: 1px; height: 16px; y: 6px; background: #3a3a3c; }

                                // Tab 3: Style
                                Rectangle {
                                    border-radius: 6px;
                                    background: root.color_tab_index == 3 ? #48484a : transparent;
                                    Text {
                                        text: "Style";
                                        color: root.color_tab_index == 3 ? #ffffff : #8e8e93;
                                        font-size: 12px;
                                        font-weight: root.color_tab_index == 3 ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.color_tab_index = 3; }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Presenter FLOATING PEN TOOL POPOVER ---
                if root.show_pen_popover: Rectangle {
                    width: 316px;
                    height: root.pen_popover_tab == 0 ? 440px : 395px;
                    x: 52px;
                    y: 35px;
                    background: #1c1c22;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: #32323e;
                    drop-shadow-blur: 28px;
                    drop-shadow-color: #000000e0;
                    animate height { duration: 150ms; easing: ease-out; }

                    // Consume clicks inside popover to prevent closing backdrop
                    TouchArea { }

                    // Left beak pointer pointing to Pen tool button on toolbar
                    Path {
                        x: -8px;
                        y: 44px;
                        width: 8px;
                        height: 14px;
                        fill: #1c1c22;
                        commands: "M 8 0 L 0 7 L 8 14 Z";
                    }

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        // Header: "Pen Tool" centered, close ✕
                        HorizontalLayout {
                            alignment: space-between;
                            Rectangle { width: 24px; }
                            Text {
                                text: "Pen Tool";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                letter-spacing: 0.2px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: touch-pen-close.has-hover ? #2e2e38 : #23232a;
                                border-width: 1px;
                                border-color: touch-pen-close.has-hover ? #40404e : #2c2c36;
                                animate background { duration: 100ms; }
                                Image {
                                    source: @image-url("icons/close.svg");
                                    width: 11px;
                                    height: 11px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: touch-pen-close.has-hover ? #ffffff : #9ca3af;
                                }
                                touch-pen-close := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_pen_popover = false; }
                                }
                            }
                        }

                        // === TAB 0: PRESETS ===
                        if root.pen_popover_tab == 0: VerticalLayout {
                            spacing: 12px;

                            // 1. Dynamic Stroke Preview Canvas
                            Rectangle {
                                height: 66px;
                                border-radius: 12px;
                                background: #131317;
                                border-width: 1px;
                                border-color: #272732;
                                clip: true;

                                // Subtle aesthetic background guideline
                                Path {
                                    width: 284px;
                                    height: 66px;
                                    stroke: #1f1f28;
                                    stroke-width: 1px;
                                    commands: "M 0 33 L 284 33";
                                }

                                // Stroke preview wave
                                Path {
                                    width: 270px;
                                    height: 48px;
                                    x: 8px;
                                    y: 9px;
                                    stroke: root.active_color;
                                    stroke-width: root.stroke_width.max(1.5px);
                                    commands: "M 20 28 C 75 28, 95 8, 140 8 C 185 8, 205 32, 250 20";
                                }

                                // Tip and Size Badge in bottom corner
                                Rectangle {
                                    x: parent.width - self.width - 8px;
                                    y: parent.height - self.height - 8px;
                                    width: 72px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: #1e1e26dd;
                                    border-width: 1px;
                                    border-color: #30303e;

                                    Text {
                                        text: (root.pen_type == 0 ? "Ball • " : (root.pen_type == 1 ? "Nib • " : "Brush • ")) + (root.pen_size_mm != "" ? root.pen_size_mm : ((Math.round(root.pen_size_value * 10) / 10) + "mm"));
                                        color: #d1d5db;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 2. "Pen Type" Section
                            VerticalLayout {
                                spacing: 7px;
                                Text {
                                    text: "PEN TYPE";
                                    color: #8e8e9a;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    // Fineliner / Ballpoint
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 58px;
                                        border-radius: 11px;
                                        background: root.pen_type == 0 ? #252a38 : (touch_pen_0.has-hover ? #25252e : #1c1c22);
                                        border-width: root.pen_type == 0 ? 1.5px : 1px;
                                        border-color: root.pen_type == 0 ? #0a84ff : (touch_pen_0.has-hover ? #383846 : #2a2a34);
                                        drop-shadow-blur: root.pen_type == 0 ? 10px : 0px;
                                        drop-shadow-color: root.pen_type == 0 ? #0a84ff30 : transparent;
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Image {
                                                source: @image-url("icons/tip_ballpoint.svg");
                                                width: 18px;
                                                height: 18px;
                                                horizontal-alignment: center;
                                                colorize: root.pen_type == 0 ? #0a84ff : #9ca3af;
                                            }
                                            Text {
                                                text: "Ballpoint";
                                                font-size: 11px;
                                                font-weight: root.pen_type == 0 ? 600 : 500;
                                                color: root.pen_type == 0 ? #ffffff : #9ca3af;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        touch_pen_0 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.pen_type = 0;
                                                root.select_pen_type(0);
                                            }
                                        }
                                    }

                                    // Fountain Pen
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 58px;
                                        border-radius: 11px;
                                        background: root.pen_type == 1 ? #252a38 : (touch_pen_1.has-hover ? #25252e : #1c1c22);
                                        border-width: root.pen_type == 1 ? 1.5px : 1px;
                                        border-color: root.pen_type == 1 ? #0a84ff : (touch_pen_1.has-hover ? #383846 : #2a2a34);
                                        drop-shadow-blur: root.pen_type == 1 ? 10px : 0px;
                                        drop-shadow-color: root.pen_type == 1 ? #0a84ff30 : transparent;
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Image {
                                                source: @image-url("icons/tip_fountain.svg");
                                                width: 18px;
                                                height: 18px;
                                                horizontal-alignment: center;
                                                colorize: root.pen_type == 1 ? #0a84ff : #9ca3af;
                                            }
                                            Text {
                                                text: "Fountain";
                                                font-size: 11px;
                                                font-weight: root.pen_type == 1 ? 600 : 500;
                                                color: root.pen_type == 1 ? #ffffff : #9ca3af;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        touch_pen_1 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.pen_type = 1;
                                                root.select_pen_type(1);
                                            }
                                        }
                                    }

                                    // Brush Pen
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 58px;
                                        border-radius: 11px;
                                        background: root.pen_type == 2 ? #252a38 : (touch_pen_2.has-hover ? #25252e : #1c1c22);
                                        border-width: root.pen_type == 2 ? 1.5px : 1px;
                                        border-color: root.pen_type == 2 ? #0a84ff : (touch_pen_2.has-hover ? #383846 : #2a2a34);
                                        drop-shadow-blur: root.pen_type == 2 ? 10px : 0px;
                                        drop-shadow-color: root.pen_type == 2 ? #0a84ff30 : transparent;
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Image {
                                                source: @image-url("icons/tip_brush.svg");
                                                width: 18px;
                                                height: 18px;
                                                horizontal-alignment: center;
                                                colorize: root.pen_type == 2 ? #0a84ff : #9ca3af;
                                            }
                                            Text {
                                                text: "Brush";
                                                font-size: 11px;
                                                font-weight: root.pen_type == 2 ? 600 : 500;
                                                color: root.pen_type == 2 ? #ffffff : #9ca3af;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        touch_pen_2 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.pen_type = 2;
                                                root.select_pen_type(2);
                                            }
                                        }
                                    }
                                }
                            }

                            // 3. "Size" Section
                            VerticalLayout {
                                spacing: 7px;
                                Text {
                                    text: "STROKE SIZE";
                                    color: #8e8e9a;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }

                                // 5 Presets: 0.35mm, 0.8mm, 1.2mm, 1.9mm, 3.8mm
                                HorizontalLayout {
                                    spacing: 6px;

                                    ToolSizeCard {
                                        label: "0.35mm";
                                        dot_diameter: 3px;
                                        is_selected: root.pen_size_mm == "0.35mm";
                                        clicked => {
                                            root.pen_size_mm = "0.35mm";
                                            root.pen_size_value = 0.35;
                                            root.stroke_width = 1.5px;
                                            root.select_pen_size(0.35, "0.35mm");
                                            root.width_changed(1.5px);
                                        }
                                    }

                                    ToolSizeCard {
                                        label: "0.8mm";
                                        dot_diameter: 5px;
                                        is_selected: root.pen_size_mm == "0.8mm";
                                        clicked => {
                                            root.pen_size_mm = "0.8mm";
                                            root.pen_size_value = 0.8;
                                            root.stroke_width = 3.5px;
                                            root.select_pen_size(0.8, "0.8mm");
                                            root.width_changed(3.5px);
                                        }
                                    }

                                    ToolSizeCard {
                                        label: "1.2mm";
                                        dot_diameter: 7px;
                                        is_selected: root.pen_size_mm == "1.2mm";
                                        clicked => {
                                            root.pen_size_mm = "1.2mm";
                                            root.pen_size_value = 1.2;
                                            root.stroke_width = 5.0px;
                                            root.select_pen_size(1.2, "1.2mm");
                                            root.width_changed(5.0px);
                                        }
                                    }

                                    ToolSizeCard {
                                        label: "1.9mm";
                                        dot_diameter: 10px;
                                        is_selected: root.pen_size_mm == "1.9mm";
                                        clicked => {
                                            root.pen_size_mm = "1.9mm";
                                            root.pen_size_value = 1.9;
                                            root.stroke_width = 8.0px;
                                            root.select_pen_size(1.9, "1.9mm");
                                            root.width_changed(8.0px);
                                        }
                                    }

                                    ToolSizeCard {
                                        label: "3.8mm";
                                        dot_diameter: 14px;
                                        is_selected: root.pen_size_mm == "3.8mm";
                                        clicked => {
                                            root.pen_size_mm = "3.8mm";
                                            root.pen_size_value = 3.8;
                                            root.stroke_width = 16.0px;
                                            root.select_pen_size(3.8, "3.8mm");
                                            root.width_changed(16.0px);
                                        }
                                    }
                                }

                                // Interactive Responsive Slider Row
                                HorizontalLayout {
                                    spacing: 10px;

                                    // Left tiny dot indicator
                                    Rectangle {
                                        width: 12px;
                                        height: 26px;
                                        Rectangle {
                                            x: 4px;
                                            y: 11px;
                                            width: 4px;
                                            height: 4px;
                                            border-radius: 2px;
                                            background: #71717a;
                                        }
                                    }

                                    // Full-width track
                                    Rectangle {
                                        height: 26px;
                                        horizontal-stretch: 1;

                                        // Track line
                                        Rectangle {
                                            y: 10px;
                                            width: parent.width;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #2a2a36;

                                            // Active filled progress
                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * (root.pen_size_value / 4.0).clamp(0.0, 1.0);
                                                height: 6px;
                                                border-radius: 3px;
                                                background: #0a84ff;
                                            }
                                        }

                                        // Thumb knob
                                        Rectangle {
                                            x: (parent.width - 20px) * (root.pen_size_value / 4.0).clamp(0.0, 1.0);
                                            y: 3px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: #ffffff;
                                            border-width: 0.5px;
                                            border-color: #00000030;
                                            drop-shadow-blur: 5px;
                                            drop-shadow-color: #00000070;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            moved => {
                                                if (self.pressed) {
                                                    let ratio = (self.mouse-x / self.width).clamp(0.05, 1.0);
                                                    let val = ratio * 4.0;
                                                    root.pen_size_value = val;
                                                    let px = (val * 4.2).max(1.0);
                                                    root.stroke_width = px * 1px;
                                                    root.select_pen_size(val, "");
                                                    root.width_changed(px * 1px);
                                                }
                                            }
                                            clicked => {
                                                let ratio = (self.mouse-x / self.width).clamp(0.05, 1.0);
                                                let val = ratio * 4.0;
                                                root.pen_size_value = val;
                                                let px = (val * 4.2).max(1.0);
                                                root.stroke_width = px * 1px;
                                                root.select_pen_size(val, "");
                                                root.width_changed(px * 1px);
                                            }
                                        }
                                    }

                                    // Right large dot indicator
                                    Rectangle {
                                        width: 12px;
                                        height: 26px;
                                        Rectangle {
                                            x: 1px;
                                            y: 8px;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: #71717a;
                                        }
                                    }

                                    // Readout Badge
                                    Rectangle {
                                        width: 52px;
                                        height: 26px;
                                        border-radius: 7px;
                                        background: #141418;
                                        border-width: 1px;
                                        border-color: #2e2e3a;

                                        Text {
                                            text: root.pen_size_mm != "" ? root.pen_size_mm : ((Math.round(root.pen_size_value * 10) / 10) + "mm");
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // === TAB 1: SETTINGS ===
                        if root.pen_popover_tab == 1: VerticalLayout {
                            spacing: 12px;

                            // Section 1: Draw and Hold
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "DRAW AND HOLD";
                                    color: #8e8e9a;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }

                                // Grouped Card for Auto Shape, Scribble to Erase & Hold Delay
                                Rectangle {
                                    border-radius: 12px;
                                    background: #1b1b22;
                                    border-width: 1px;
                                    border-color: #2a2a36;

                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 10px;

                                        // Auto Shape
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "Auto Shape";
                                                    color: #f3f4f6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Text {
                                                    text: "Hold at end of stroke to snap shapes";
                                                    color: #8e8e93;
                                                    font-size: 10.5px;
                                                }
                                            }
                                            PresenterToggle {
                                                checked: root.auto_shape_enabled;
                                                toggled(val) => {
                                                    root.auto_shape_enabled = val;
                                                    root.toggle_auto_shape(val);
                                                }
                                            }
                                        }

                                        Rectangle { height: 1px; background: #262632; }

                                        // Scribble to Erase
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "Scribble to Erase";
                                                    color: #f3f4f6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Text {
                                                    text: "Scribble back and forth to erase stroke";
                                                    color: #8e8e93;
                                                    font-size: 10.5px;
                                                }
                                            }
                                            PresenterToggle {
                                                checked: root.scribble_to_erase;
                                                toggled(val) => {
                                                    root.scribble_to_erase = val;
                                                    root.toggle_scribble_to_erase(val);
                                                }
                                            }
                                        }

                                        Rectangle { height: 1px; background: #262632; }

                                        // Delay Slider Row
                                        HorizontalLayout {
                                            spacing: 10px;

                                            Text {
                                                text: "Delay";
                                                color: #f3f4f6;
                                                font-size: 13px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                                min-width: 38px;
                                            }

                                            // Full-width Delay Slider Track
                                            Rectangle {
                                                height: 24px;
                                                horizontal-stretch: 1;

                                                Rectangle {
                                                    y: 9px;
                                                    width: parent.width;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: #282834;
                                                    Rectangle {
                                                        x: 0px;
                                                        width: parent.width * ((root.hold_delay_s - 0.2) / 1.3).clamp(0.0, 1.0);
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: #0a84ff;
                                                    }
                                                }

                                                Rectangle {
                                                    x: (parent.width - 20px) * ((root.hold_delay_s - 0.2) / 1.3).clamp(0.0, 1.0);
                                                    y: 2px;
                                                    width: 20px;
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: #ffffff;
                                                    border-width: 0.5px;
                                                    border-color: #00000030;
                                                    drop-shadow-blur: 5px;
                                                    drop-shadow-color: #00000070;
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    moved => {
                                                        if (self.pressed) {
                                                            let ratio = (self.mouse-x / self.width).clamp(0.0, 1.0);
                                                            let val = 0.2 + ratio * 1.3;
                                                            root.hold_delay_s = val;
                                                            root.change_hold_delay(val);
                                                        }
                                                    }
                                                    clicked => {
                                                        let ratio = (self.mouse-x / self.width).clamp(0.0, 1.0);
                                                        let val = 0.2 + ratio * 1.3;
                                                        root.hold_delay_s = val;
                                                        root.change_hold_delay(val);
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                width: 44px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #141418;
                                                border-width: 1px;
                                                border-color: #2a2a34;
                                                Text {
                                                    text: root.hold_delay_text;
                                                    color: #ffffff;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Section 2: Pen Pressure
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "PEN PRESSURE";
                                    color: #8e8e9a;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }

                                // Grouped Card for Pressure Settings
                                Rectangle {
                                    border-radius: 12px;
                                    background: #1b1b22;
                                    border-width: 1px;
                                    border-color: #2a2a36;

                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 10px;

                                        // Enhanced Sensitivity
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "Enhanced Sensitivity";
                                                    color: #f3f4f6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Text {
                                                    text: "Updates with latest pen pressure";
                                                    color: #8e8e93;
                                                    font-size: 10.5px;
                                                }
                                            }
                                            PresenterToggle {
                                                checked: root.enhanced_sensitivity;
                                                toggled(val) => {
                                                    root.enhanced_sensitivity = val;
                                                    root.toggle_enhanced_sensitivity(val);
                                                }
                                            }
                                        }

                                        Rectangle { height: 1px; background: #262632; }

                                        // Draw on Hover
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "Draw on Hover";
                                                    color: #f3f4f6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Text {
                                                    text: "Draw even without pen pressure";
                                                    color: #8e8e93;
                                                    font-size: 10.5px;
                                                }
                                            }
                                            PresenterToggle {
                                                checked: root.draw_on_hover;
                                                toggled(val) => {
                                                    root.draw_on_hover = val;
                                                    root.toggle_draw_on_hover(val);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // === BOTTOM TAB SWITCHER PILL ===
                        Rectangle {
                            height: 38px;
                            background: #131317;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #272732;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 4px;

                                // Left: Presets Tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 7px;
                                    background: root.pen_popover_tab == 0 ? #2c2d38 : (touch_tab_0.has-hover ? #202028 : transparent);
                                    border-width: root.pen_popover_tab == 0 ? 1px : 0px;
                                    border-color: #3e3f4e;
                                    drop-shadow-blur: root.pen_popover_tab == 0 ? 4px : 0px;
                                    drop-shadow-color: #00000040;
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 7px;
                                        Image {
                                            source: @image-url("icons/tab_presets.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: root.pen_popover_tab == 0 ? #ffffff : #8e8e9a;
                                        }
                                        Text {
                                            text: "Presets";
                                            font-size: 12px;
                                            font-weight: root.pen_popover_tab == 0 ? 600 : 500;
                                            color: root.pen_popover_tab == 0 ? #ffffff : #8e8e9a;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch_tab_0 := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pen_popover_tab = 0; }
                                    }
                                }

                                // Right: Settings Tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 7px;
                                    background: root.pen_popover_tab == 1 ? #2c2d38 : (touch_tab_1.has-hover ? #202028 : transparent);
                                    border-width: root.pen_popover_tab == 1 ? 1px : 0px;
                                    border-color: #3e3f4e;
                                    drop-shadow-blur: root.pen_popover_tab == 1 ? 4px : 0px;
                                    drop-shadow-color: #00000040;
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 7px;
                                        Image {
                                            source: @image-url("icons/tab_settings.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: root.pen_popover_tab == 1 ? #ffffff : #8e8e9a;
                                        }
                                        Text {
                                            text: "Settings";
                                            font-size: 12px;
                                            font-weight: root.pen_popover_tab == 1 ? 600 : 500;
                                            color: root.pen_popover_tab == 1 ? #ffffff : #8e8e9a;
                                            vertical-alignment: center;
                                        }
                                    }
                                    touch_tab_1 := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pen_popover_tab = 1; }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Presenter FLOATING HIGHLIGHTER TOOL POPOVER ---
                if root.show_highlighter_popover: Rectangle {
                    width: 295px;
                    height: 255px;
                    x: 52px;
                    y: 75px;
                    background: #1c1c1f;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: #2c2c34;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000dd;

                    // Consume clicks inside popover to prevent closing backdrop
                    TouchArea { }

                    // Left beak pointer pointing to Highlighter tool button on toolbar
                    Path {
                        x: -8px;
                        y: 35px;
                        width: 8px;
                        height: 14px;
                        fill: #1c1c1f;
                        commands: "M 8 0 L 0 7 L 8 14 Z";
                    }

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        // Header: "Highlighter" centered with close ✕ button
                        HorizontalLayout {
                            alignment: space-between;
                            Rectangle { width: 22px; height: 1px; background: transparent; }
                            Text {
                                text: "Highlighter";
                                color: #f3f4f6;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: touch_hl_close.has-hover ? #2e2e34 : transparent;
                                Image {
                                    source: @image-url("icons/close.svg");
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: #9ca3af;
                                }
                                touch_hl_close := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_highlighter_popover = false; }
                                }
                            }
                        }

                        // Section 1: "Size"
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Size";
                                color: #9ca3af;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            // 5 Presets: 1.9mm, 2.7mm, 4.6mm, 5.4mm, 6.2mm
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: space-between;

                                ToolSizeCard {
                                    label: "1.9mm";
                                    dot_diameter: 6px;
                                    is_selected: root.highlighter_size_mm == "1.9mm";
                                    clicked => {
                                        root.highlighter_size_mm = "1.9mm";
                                        root.highlighter_size_value = 1.9;
                                        root.stroke_width = 8.0px;
                                        root.select_highlighter_size(1.9, "1.9mm");
                                        root.width_changed(8.0px);
                                    }
                                }

                                ToolSizeCard {
                                    label: "2.7mm";
                                    dot_diameter: 8px;
                                    is_selected: root.highlighter_size_mm == "2.7mm";
                                    clicked => {
                                        root.highlighter_size_mm = "2.7mm";
                                        root.highlighter_size_value = 2.7;
                                        root.stroke_width = 11.5px;
                                        root.select_highlighter_size(2.7, "2.7mm");
                                        root.width_changed(11.5px);
                                    }
                                }

                                ToolSizeCard {
                                    label: "4.6mm";
                                    dot_diameter: 13px;
                                    is_selected: root.highlighter_size_mm == "4.6mm";
                                    clicked => {
                                        root.highlighter_size_mm = "4.6mm";
                                        root.highlighter_size_value = 4.6;
                                        root.stroke_width = 19.5px;
                                        root.select_highlighter_size(4.6, "4.6mm");
                                        root.width_changed(19.5px);
                                    }
                                }

                                ToolSizeCard {
                                    label: "5.4mm";
                                    dot_diameter: 16px;
                                    is_selected: root.highlighter_size_mm == "5.4mm";
                                    clicked => {
                                        root.highlighter_size_mm = "5.4mm";
                                        root.highlighter_size_value = 5.4;
                                        root.stroke_width = 23.0px;
                                        root.select_highlighter_size(5.4, "5.4mm");
                                        root.width_changed(23.0px);
                                    }
                                }

                                ToolSizeCard {
                                    label: "6.2mm";
                                    dot_diameter: 19px;
                                    is_selected: root.highlighter_size_mm == "6.2mm";
                                    clicked => {
                                        root.highlighter_size_mm = "6.2mm";
                                        root.highlighter_size_value = 6.2;
                                        root.stroke_width = 26.0px;
                                        root.select_highlighter_size(6.2, "6.2mm");
                                        root.width_changed(26.0px);
                                    }
                                }
                            }

                            // Interactive Responsive Slider Row
                            HorizontalLayout {
                                spacing: 10px;

                                // Left tiny dot indicator
                                Rectangle {
                                    width: 12px;
                                    height: 26px;
                                    Rectangle {
                                        x: 4px;
                                        y: 11px;
                                        width: 4px;
                                        height: 4px;
                                        border-radius: 2px;
                                        background: #71717a;
                                    }
                                }

                                // Full-width track
                                Rectangle {
                                    height: 26px;
                                    horizontal-stretch: 1;

                                    // Track line
                                    Rectangle {
                                        y: 10px;
                                        width: parent.width;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #2a2a36;

                                        // Active filled progress
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * ((root.highlighter_size_value - 1.0) / 7.0).clamp(0.0, 1.0);
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #0a84ff;
                                        }
                                    }

                                    // Thumb knob
                                    Rectangle {
                                        x: (parent.width - 20px) * ((root.highlighter_size_value - 1.0) / 7.0).clamp(0.0, 1.0);
                                        y: 3px;
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: #ffffff;
                                        border-width: 0.5px;
                                        border-color: #00000030;
                                        drop-shadow-blur: 5px;
                                        drop-shadow-color: #00000070;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        moved => {
                                            if (self.pressed) {
                                                let ratio = (self.mouse-x / self.width).clamp(0.0, 1.0);
                                                let val = 1.0 + ratio * 7.0;
                                                root.highlighter_size_value = val;
                                                let px = (val * 4.2).max(2.0);
                                                root.stroke_width = px * 1px;
                                                root.select_highlighter_size(val, "");
                                                root.width_changed(px * 1px);
                                            }
                                        }
                                        clicked => {
                                            let ratio = (self.mouse-x / self.width).clamp(0.0, 1.0);
                                            let val = 1.0 + ratio * 7.0;
                                            root.highlighter_size_value = val;
                                            let px = (val * 4.2).max(2.0);
                                            root.stroke_width = px * 1px;
                                            root.select_highlighter_size(val, "");
                                            root.width_changed(px * 1px);
                                        }
                                    }
                                }

                                // Right large dot indicator
                                Rectangle {
                                    width: 12px;
                                    height: 26px;
                                    Rectangle {
                                        x: 1px;
                                        y: 8px;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: #71717a;
                                    }
                                }

                                // Readout Badge
                                Rectangle {
                                    width: 52px;
                                    height: 26px;
                                    border-radius: 7px;
                                    background: #141418;
                                    border-width: 1px;
                                    border-color: #2e2e3a;

                                    Text {
                                        text: root.highlighter_size_mm != "" ? root.highlighter_size_mm : ((Math.round(root.highlighter_size_value * 10) / 10) + "mm");
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 2: "Options"
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Options";
                                color: #9ca3af;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            // Card with "Draw Straight Lines" and toggle
                            Rectangle {
                                height: 44px;
                                border-radius: 10px;
                                background: #202024;
                                border-width: 1px;
                                border-color: #2c2c32;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    Text {
                                        text: "Draw Straight Lines";
                                        color: #f3f4f6;
                                        font-size: 14px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }

                                    PresenterToggle {
                                        checked: root.highlighter_straight_lines;
                                        toggled(val) => {
                                            root.highlighter_straight_lines = val;
                                            root.toggle_highlighter_straight_lines(val);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Presenter FLOATING ERASER TOOL POPOVER ---
                if root.show_eraser_popover: Rectangle {
                    width: 295px;
                    height: 375px;
                    x: 52px;
                    y: 95px;
                    background: #1c1c1f;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: #2c2c34;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000dd;

                    // Consume clicks inside popover to prevent closing backdrop
                    TouchArea { }

                    // Left beak pointer pointing to Eraser tool button on toolbar
                    Path {
                        x: -8px;
                        y: 44px;
                        width: 8px;
                        height: 14px;
                        fill: #1c1c1f;
                        commands: "M 8 0 L 0 7 L 8 14 Z";
                    }

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        // Top Header: "Reset" on left, "Eraser Tool" in center
                        Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Reset";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: touch_eraser_reset.has-hover ? #38bdf8 : #007aff;
                                    vertical-alignment: center;
                                    touch_eraser_reset := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.eraser_size_index = 2;
                                            root.eraser_radius = 0.04;
                                            root.erase_whole_line = false;
                                            root.erase_highlight_only = false;
                                            root.auto_select_previous_tool = false;
                                            root.erase_shapes = true;
                                            root.erase_tapes = false;
                                            root.reset_eraser_settings();
                                        }
                                    }
                                }

                                Text {
                                    text: "Eraser Tool";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                // Placeholder to balance center alignment
                                Rectangle {
                                    width: 42px;
                                    height: 1px;
                                    background: transparent;
                                }
                            }
                        }

                        // Section 1: "Size"
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Size";
                                color: #9ca3af;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            // 5 Presets: white concentric circles from small to large
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: space-between;

                                ToolSizeCard {
                                    dot_diameter: 6px;
                                    is_selected: root.eraser_size_index == 0;
                                    clicked => {
                                        root.eraser_size_index = 0;
                                        root.eraser_radius = 0.015;
                                        root.select_eraser_size(0, 0.015);
                                    }
                                }

                                ToolSizeCard {
                                    dot_diameter: 10px;
                                    is_selected: root.eraser_size_index == 1;
                                    clicked => {
                                        root.eraser_size_index = 1;
                                        root.eraser_radius = 0.025;
                                        root.select_eraser_size(1, 0.025);
                                    }
                                }

                                ToolSizeCard {
                                    dot_diameter: 16px;
                                    is_selected: root.eraser_size_index == 2;
                                    clicked => {
                                        root.eraser_size_index = 2;
                                        root.eraser_radius = 0.040;
                                        root.select_eraser_size(2, 0.040);
                                    }
                                }

                                ToolSizeCard {
                                    dot_diameter: 22px;
                                    is_selected: root.eraser_size_index == 3;
                                    clicked => {
                                        root.eraser_size_index = 3;
                                        root.eraser_radius = 0.060;
                                        root.select_eraser_size(3, 0.060);
                                    }
                                }

                                ToolSizeCard {
                                    dot_diameter: 28px;
                                    is_selected: root.eraser_size_index == 4;
                                    clicked => {
                                        root.eraser_size_index = 4;
                                        root.eraser_radius = 0.085;
                                        root.select_eraser_size(4, 0.085);
                                    }
                                }
                            }
                        }

                        // Section 2: "Options"
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Options";
                                color: #9ca3af;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            // Grouped Card for all 5 Eraser options
                            Rectangle {
                                border-radius: 12px;
                                background: #202024;
                                border-width: 1px;
                                border-color: #2c2c32;

                                VerticalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 0px;

                                    // 1. Erase Whole Line
                                    HorizontalLayout {
                                        height: 38px;
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        alignment: space-between;
                                        Text {
                                            text: "Erase Whole Line";
                                            color: #f3f4f6;
                                            font-size: 13px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                        PresenterToggle {
                                            checked: root.erase_whole_line;
                                            toggled(val) => {
                                                root.erase_whole_line = val;
                                                root.toggle_erase_whole_line(val);
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: #2a2a30; }

                                    // 2. Erase Highlight Only
                                    HorizontalLayout {
                                        height: 38px;
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        alignment: space-between;
                                        Text {
                                            text: "Erase Highlight Only";
                                            color: #f3f4f6;
                                            font-size: 13px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                        PresenterToggle {
                                            checked: root.erase_highlight_only;
                                            toggled(val) => {
                                                root.erase_highlight_only = val;
                                                root.toggle_erase_highlight_only(val);
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: #2a2a30; }

                                    // 3. Auto-select Previous Tool
                                    HorizontalLayout {
                                        height: 38px;
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        alignment: space-between;
                                        Text {
                                            text: "Auto-select Previous Tool";
                                            color: #f3f4f6;
                                            font-size: 13px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                        PresenterToggle {
                                            checked: root.auto_select_previous_tool;
                                            toggled(val) => {
                                                root.auto_select_previous_tool = val;
                                                root.toggle_auto_select_previous_tool(val);
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: #2a2a30; }

                                    // 4. Erase Shapes
                                    HorizontalLayout {
                                        height: 38px;
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        alignment: space-between;
                                        Text {
                                            text: "Erase Shapes";
                                            color: #f3f4f6;
                                            font-size: 13px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                         PresenterToggle {
                                            checked: root.erase_shapes;
                                            toggled(val) => {
                                                root.erase_shapes = val;
                                                root.toggle_erase_shapes(val);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Presenter FLOATING PRESENTATION TOOL POPOVER ---
                if root.show_laser_popover: Rectangle {
                    width: 300px;
                    height: 258px;
                    x: 52px;
                    y: 160px;
                    background: #1c1c1f;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: #2c2c34;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000dd;

                    // Consume clicks inside popover to prevent closing backdrop
                    TouchArea { }

                    // Left beak pointer pointing directly to Laser Pointer button on toolbar
                    Path {
                        x: -8px;
                        y: 95px;
                        width: 8px;
                        height: 14px;
                        fill: #1c1c1f;
                        commands: "M 8 0 L 0 7 L 8 14 Z";
                    }

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        // Title: "Presentation Tool" centered bold
                        Text {
                            text: "Presentation Tool";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                        }

                        // Pointer Style section
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Pointer Style";
                                font-size: 13px;
                                font-weight: 600;
                                color: #9ca3af;
                            }

                            // 4 Color Swatches: Red (#ff3b30), Blue (#0055ff), Green (#00e53a), Purple (#b800ff)
                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;

                                // Red
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    background: transparent;

                                    if root.laser_color_index == 0: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        background: #ff3b30.transparentize(0.7);
                                        border-width: 2px;
                                        border-color: #ff3b30;
                                        drop-shadow-blur: 10px;
                                        drop-shadow-color: #ff3b30;
                                    }

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #ff3b30;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.laser_color_index = 0;
                                            root.laser_color = #ff3b30;
                                            root.select_laser_color(0, #ff3b30);
                                        }
                                    }
                                }

                                // Blue
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    background: transparent;

                                    if root.laser_color_index == 1: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        background: #0055ff.transparentize(0.7);
                                        border-width: 2px;
                                        border-color: #0055ff;
                                        drop-shadow-blur: 10px;
                                        drop-shadow-color: #0055ff;
                                    }

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #0055ff;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.laser_color_index = 1;
                                            root.laser_color = #0055ff;
                                            root.select_laser_color(1, #0055ff);
                                        }
                                    }
                                }

                                // Green
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    background: transparent;

                                    if root.laser_color_index == 2: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        background: #00e53a.transparentize(0.7);
                                        border-width: 2px;
                                        border-color: #00e53a;
                                        drop-shadow-blur: 10px;
                                        drop-shadow-color: #00e53a;
                                    }

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #00e53a;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.laser_color_index = 2;
                                            root.laser_color = #00e53a;
                                            root.select_laser_color(2, #00e53a);
                                        }
                                    }
                                }

                                // Purple
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    background: transparent;

                                    if root.laser_color_index == 3: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        background: #b800ff.transparentize(0.7);
                                        border-width: 2px;
                                        border-color: #b800ff;
                                        drop-shadow-blur: 10px;
                                        drop-shadow-color: #b800ff;
                                    }

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #b800ff;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.laser_color_index = 3;
                                            root.laser_color = #b800ff;
                                            root.select_laser_color(3, #b800ff);
                                        }
                                    }
                                }
                            }
                        }

                        // Card: Draw Lines with toggle switch
                        Rectangle {
                            height: 44px;
                            border-radius: 10px;
                            background: #202024;
                            border-width: 1px;
                            border-color: #2c2c32;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    // Diagonal line icon "/"
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        y: 13px;
                                        background: transparent;
                                        Path {
                                            x: 2px;
                                            y: 2px;
                                            width: 14px;
                                            height: 14px;
                                            stroke: #8e8e93;
                                            stroke-width: 2px;
                                            commands: "M 13 1 L 1 13";
                                        }
                                    }

                                    Text {
                                        text: "Draw Lines";
                                        color: #f3f4f6;
                                        font-size: 14px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                PresenterToggle {
                                    checked: root.laser_draw_lines;
                                    toggled(val) => {
                                        root.laser_draw_lines = val;
                                        root.toggle_laser_draw_lines(val);
                                    }
                                }
                            }
                        }

                        // Card: Laser Pointer Fade Duration Controller (0.0s to 5.0s with decimals)
                        Rectangle {
                            height: 60px;
                            border-radius: 10px;
                            background: #202024;
                            border-width: 1px;
                            border-color: #2c2c32;

                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Fade Time";
                                        color: #f3f4f6;
                                        font-size: 13px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        // Decrement -0.1s button
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: minus_laser_touch.has-hover ? #374151 : #2a2a30;

                                            Text {
                                                text: "-";
                                                color: #e5e7eb;
                                                font-size: 15px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            minus_laser_touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    let val = max(0.0, Math.round((root.laser_fade_duration_s - 0.1) * 10) / 10);
                                                    root.laser_fade_duration_s = val;
                                                    root.laser_fade_duration_text = val + "s";
                                                    root.change_laser_fade_duration(val);
                                                }
                                            }
                                        }

                                        // Decimal readout badge (e.g. 1.8s)
                                        Rectangle {
                                            width: 48px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: #141416;
                                            border-width: 1px;
                                            border-color: #2c2c34;

                                            Text {
                                                text: root.laser_fade_duration_text;
                                                color: #60a5fa;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Increment +0.1s button
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: plus_laser_touch.has-hover ? #374151 : #2a2a30;

                                            Text {
                                                text: "+";
                                                color: #e5e7eb;
                                                font-size: 15px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            plus_laser_touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    let val = min(5.0, Math.round((root.laser_fade_duration_s + 0.1) * 10) / 10);
                                                    root.laser_fade_duration_s = val;
                                                    root.laser_fade_duration_text = val + "s";
                                                    root.change_laser_fade_duration(val);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Interactive Slider (0.0s to 5.0s)
                                Rectangle {
                                    height: 18px;

                                    // Track background
                                    Rectangle {
                                        y: 6px;
                                        width: parent.width;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #2c2c34;

                                        // Active filled track
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * (root.laser_fade_duration_s / 5.0).clamp(0.0, 1.0);
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #3b82f6;
                                        }
                                    }

                                    // Slider Thumb / Knob
                                    Rectangle {
                                        x: (parent.width - 16px) * (root.laser_fade_duration_s / 5.0).clamp(0.0, 1.0);
                                        y: 1px;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: #ffffff;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #00000088;
                                    }

                                    fade_slider_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        moved => {
                                            if (self.pressed) {
                                                let ratio = (self.mouse-x / self.width).clamp(0.0, 1.0);
                                                let val = Math.round(ratio * 50.0) / 10.0;
                                                root.laser_fade_duration_s = val;
                                                root.laser_fade_duration_text = val + "s";
                                                root.change_laser_fade_duration(val);
                                            }
                                        }
                                        clicked => {
                                            let ratio = (self.mouse-x / self.width).clamp(0.0, 1.0);
                                            let val = Math.round(ratio * 50.0) / 10.0;
                                            root.laser_fade_duration_s = val;
                                            root.laser_fade_duration_text = val + "s";
                                            root.change_laser_fade_duration(val);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- MEDIA CONTROLLER (Docked at bottom of slide window, resizes with canvas_area) ---
                if root.current_has_media: media_ctrl := Rectangle {
                    x: 0px;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 52px;
                    background: #0f0f0ff8;
                    border-width: 0px;

                    // Top border line
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 1px;
                        background: #27272a;
                    }

                    // 1. YouTube Red Progress Scrubber Line (at top edge, y: 0)
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: scrubber_touch.has-hover ? 6px : 4px;
                        background: #ffffff33;

                        // Buffered bar (YouTube buffer preview)
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * min(1.0, max(0.0, root.media_progress + 0.35));
                            height: 100%;
                            background: #ffffff4d;
                        }

                        // Elapsed Progress Bar (YouTube Iconic Red #ff0000)
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * max(0.0, min(1.0, root.media_progress));
                            height: 100%;
                            background: #ff0000;
                        }

                        // Scrubber Thumb (YouTube Red Circle)
                        Rectangle {
                            x: (parent.width - 13px) * max(0.0, min(1.0, root.media_progress));
                            y: -4px;
                            width: 13px;
                            height: 13px;
                            border-radius: 6.5px;
                            background: #ff0000;
                            border-width: 1px;
                            border-color: #ffffff33;
                            opacity: scrubber_touch.has-hover ? 1.0 : (root.media_playing ? 1.0 : 0.9);
                        }

                        scrubber_touch := TouchArea {
                            mouse-cursor: pointer;
                            moved => {
                                if (self.pressed) {
                                    let p = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                                    root.seek_media(p);
                                }
                            }
                            clicked => {
                                let p = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                                root.seek_media(p);
                            }
                        }
                    }

                    // 2. Main Controls Bar (below scrubber line)
                    HorizontalLayout {
                        y: 4px;
                        height: 48px;
                        padding-left: 16px;
                        padding-right: 18px;
                        alignment: space-between;

                        // Left-side Controls: Play/Pause/Replay, Stop, Volume, Time Readout
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            // Play / Pause / Replay Button (white symbol, no background)
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                background: transparent;
                                y: 8px;

                                Image {
                                    source: root.media_progress >= 0.99 ? @image-url("icons/replay.svg") : (root.media_playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"));
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: play_touch.has-hover ? root.active_color : #ffffff;
                                }

                                play_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle_media_playback(); }
                                }
                            }

                            // Stop Button (square white symbol, no background)
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                background: transparent;
                                y: 8px;

                                Image {
                                    source: @image-url("icons/stop.svg");
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: stop_touch.has-hover ? #ef4444 : #ffffff;
                                }

                                stop_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.stop_media(); }
                                }
                            }

                            // Volume / Audio Mute Button (white symbol, no background)
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                background: transparent;
                                y: 8px;

                                Image {
                                    source: root.media_speech_active ? @image-url("icons/volume.svg") : @image-url("icons/mute.svg");
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: vol_touch.has-hover ? root.active_color : #ffffff;
                                }

                                vol_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle_media_speech(); }
                                }
                            }

                            // Time Readout: 00:00 / 01:30 (Matches YouTube exactly)
                            Text {
                                text: root.media_time_text;
                                color: #dddddd;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }

                        // Right-side Controls: Clip switcher, Speed badge
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;

                            // Clip Switcher (only on slides with several clips): ‹ 1/2 ›
                            if root.media_clip_count > 1: HorizontalLayout {
                                spacing: 4px;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    y: 10px;
                                    border-radius: 14px;
                                    background: prev_clip_touch.has-hover ? #ffffff2a : #ffffff14;
                                    Text {
                                        text: "‹";
                                        color: #f4f4f5;
                                        font-size: 16px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    prev_clip_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select_media_clip(root.media_clip_index - 1); }
                                    }
                                }

                                Text {
                                    text: "Clip \{root.media_clip_index + 1}/\{root.media_clip_count}";
                                    color: #dddddd;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    y: 10px;
                                    border-radius: 14px;
                                    background: next_clip_touch.has-hover ? #ffffff2a : #ffffff14;
                                    Text {
                                        text: "›";
                                        color: #f4f4f5;
                                        font-size: 16px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    next_clip_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select_media_clip(root.media_clip_index + 1); }
                                    }
                                }
                            }

                            // Speed Button
                            Rectangle {
                                width: 50px;
                                height: 28px;
                                border-radius: 14px;
                                background: speed_touch.has-hover ? #ffffff2a : #ffffff14;
                                y: 10px;

                                Text {
                                    text: root.media_speed_text;
                                    color: #f4f4f5;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                speed_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle_media_speed(); }
                                }
                            }
                        }
                    }
                }
            }

            // Splitter divider between Slide and Notes (Vertical draggable slider)
            if !root.show_thumbnails && root.notes_drawer_open: Rectangle {
                x: parent.width - main_workspace.drawer_w - 6px;
                y: 0px;
                width: 6px;
                height: parent.height;
                background: splitter_touch.has-hover ? #3b82f6 : #18181b;
                border-width: 1px;
                border-color: splitter_touch.has-hover ? #60a5fa : #26262a;

                Rectangle {
                    width: 2px;
                    height: 48px;
                    border-radius: 1px;
                    background: splitter_touch.has-hover ? #ffffff : #52525b;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                splitter_touch := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            let total_w = max(100px, main_workspace.width - 56px);
                            let mouse_dist_from_right = main_workspace.drawer_w + 6px - self.mouse-x;
                            let new_ratio = max(0.15, min(0.70, (mouse_dist_from_right / 1px) / (total_w / 1px)));
                            root.notes_split_ratio = new_ratio;
                        }
                    }
                }
            }

            // 3. COLLAPSIBLE RIGHT DRAWER (Presenter Notes & Next Slide)
            if !root.show_thumbnails && root.notes_drawer_open: Rectangle {
                x: parent.width - main_workspace.drawer_w;
                y: 0px;
                width: main_workspace.drawer_w;
                height: parent.height;
                background: #1c1c1f;
                border-width: 1px;
                border-color: #27272b;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "SPEAKER NOTES & CONTROLS";
                            color: #9ca3af;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 4px;
                            background: touch-close-notes.has-hover ? #2e2e34 : transparent;
                            Text {
                                text: "×";
                                color: #9ca3af;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            touch-close-notes := TouchArea {
                                clicked => { root.notes_drawer_open = false; }
                            }
                        }
                    }


                    // Visual Preview Section: Dual-Screen Beamer Note Slide or Next Slide Preview
                    preview_box := Rectangle {
                        vertical-stretch: max(15, Math.round(root.note_preview_ratio * 100));
                        min-height: 80px;
                        background: #121214;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #27272a;
                        clip: true;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 2px;

                                Text {
                                    text: root.has_notes_image 
                                        ? (root.is_dual_screen ? "📐 DUAL-SCREEN NOTE SLIDE (pgfpages)" : "📝 PRESENTER SPEAKER NOTE")
                                        : (root.current_slide < root.total_slides ? "⏭ NEXT SLIDE PREVIEW" 
                                        : (root.is_end_of_show ? "◼ END OF SHOW" : "⏭ NEXT: BLACK SCREEN"));
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: root.has_notes_image ? #34d399 : (root.current_slide < root.total_slides ? #93c5fd : #f87171);
                                }

                                if root.has_notes_image: Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: #064e3b;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.is_dual_screen ? "32:9 Split" : "Note Page";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: #6ee7b7;
                                            vertical-alignment: center;
                                         }
                                     }
                                 }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.has_notes_image ? root.notes_slide_image : (root.current_slide < root.total_slides ? root.next_slide_image : (root.is_end_of_show ? root.current_slide_image : root.next_slide_image));
                                    image-fit: contain;
                                }
                            }
                        }
                    }

                    // Draggable Horizontal Splitter Slider between Note Preview and Speaker Notes
                    Rectangle {
                        height: 12px;
                        background: h_splitter_touch.has-hover ? #2563eb22 : transparent;
                        border-radius: 4px;

                        // Center line
                        Rectangle {
                            height: 2px;
                            width: 100%;
                            y: 5px;
                            background: h_splitter_touch.has-hover ? #3b82f6 : #27272a;
                        }

                        // Grab handle in the center
                        Rectangle {
                            width: 44px;
                            height: 4px;
                            y: 4px;
                            x: (parent.width - self.width) / 2;
                            border-radius: 2px;
                            background: h_splitter_touch.has-hover ? #60a5fa : #52525b;
                        }

                        h_splitter_touch := TouchArea {
                            mouse-cursor: row-resize;
                            moved => {
                                if (self.pressed) {
                                    let total_h = max(200px, preview_box.height + comments_box.height);
                                    let current_mouse_h = preview_box.height + self.mouse-y;
                                    let new_ratio = max(0.15, min(0.70, (current_mouse_h / 1px) / (total_h / 1px)));
                                    root.note_preview_ratio = new_ratio;
                                }
                            }
                        }
                    }

                    // Interactive Comments & Speaker Notes Section
                    comments_box := Rectangle {
                        vertical-stretch: max(25, Math.round((1.0 - root.note_preview_ratio) * 100));
                        min-height: 120px;
                        background: #141416;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #27272a;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;

                            // Header with title and quick snippet action buttons
                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "SPEAKER COMMENTS & NOTES";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #a1a1aa;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 4px;

                                    // + Bullet button
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: btn_bullet.has-hover ? #374151 : #27272a;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: "+ Bullet";
                                                font-size: 10px;
                                                color: #e5e7eb;
                                                vertical-alignment: center;
                                            }
                                        }
                                        btn_bullet := TouchArea {
                                            clicked => {
                                                root.notes_text = root.notes_text + (root.notes_text == "" ? "• " : "\n• ");
                                                root.update_slide_notes(root.current_slide, root.notes_text);
                                            }
                                        }
                                    }

                                    // + Reminder button
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: btn_rem.has-hover ? #374151 : #27272a;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: "⏰ Reminder";
                                                font-size: 10px;
                                                color: #fbbf24;
                                                vertical-alignment: center;
                                            }
                                        }
                                        btn_rem := TouchArea {
                                            clicked => {
                                                root.notes_text = root.notes_text + (root.notes_text == "" ? "⏰ Reminder: " : "\n⏰ Reminder: ");
                                                root.update_slide_notes(root.current_slide, root.notes_text);
                                            }
                                        }
                                    }

                                    // Clear button
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: btn_clr.has-hover ? #451a1a : #27272a;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: "Clear";
                                                font-size: 10px;
                                                color: #f87171;
                                                vertical-alignment: center;
                                            }
                                        }
                                        btn_clr := TouchArea {
                                            clicked => {
                                                root.notes_text = "";
                                                root.update_slide_notes(root.current_slide, "");
                                            }
                                        }
                                    }
                                }
                            }

                            // Editable Comment Box
                            Rectangle {
                                vertical-stretch: 1;
                                background: #1c1c20;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: comment_input.has-focus ? #3b82f6 : #2e2e34;
                                clip: true;

                                ScrollView {
                                    VerticalLayout {
                                        padding: 8px;

                                        comment_input := TextInput {
                                            text: root.notes_text;
                                            color: #f3f4f6;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                            edited => {
                                                root.notes_text = self.text;
                                                root.update_slide_notes(root.current_slide, self.text);
                                            }
                                        }
                                    }
                                }

                                if root.notes_text == "" && !comment_input.has-focus: Text {
                                    x: 10px;
                                    y: 10px;
                                    text: "✍️ Type speaker comments, LaTeX derivations, or timing notes for this slide...";
                                    color: #52525b;
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    // Pop out independent Notes Window button
                    Rectangle {
                        height: 32px;
                        background: #2563eb;
                        border-radius: 6px;

                        Text {
                            text: "📝 Detach to Separate Window";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { root.toggle_notes_window(); }
                        }
                    }
                }
            }
        }
    }

    // --- Presenter INSERT PAGE MODAL (Matching exact design from Screenshot) ---
    if root.show_insert_page_modal: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000ba;

        // Backdrop click to dismiss
        modal_backdrop := TouchArea {
            clicked => {
                root.show_insert_page_modal = false;
            }
        }

        // Modal Dialog Box centered
        modal_dialog := Rectangle {
            width: 580px;
            height: 520px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #18181b;
            border-radius: 18px;
            border-width: 1.5px;
            border-color: #2e2e34;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000ff;
            clip: true;

            // TouchArea inside modal to prevent closing when clicking inside dialog
            TouchArea { }

            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 20px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 14px;

                // 1. Header Bar: Title and Close button
                HorizontalLayout {
                    alignment: space-between;

                    // Empty spacer for centering
                    Rectangle { width: 28px; height: 28px; background: transparent; }

                    Text {
                        text: "Insert Page";
                        color: #ffffff;
                        font-size: 19px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Close ✕ Button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: close_touch.has-hover ? #383840 : #26262c;

                        Image {
                            source: @image-url("icons/close.svg");
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #9ca3af;
                        }

                        close_touch := TouchArea {
                            clicked => { root.show_insert_page_modal = false; }
                        }
                    }
                }

                // 2. Subtitle with Position Picker: "Insert template [ After current page ▾ ] :"
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;

                    Text {
                        text: "Insert template";
                        color: #9ca3af;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    // Blue position selector pill
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: pos_touch.has-hover ? #2563eb : #007aff;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: root.get_position_name(root.insert_position_mode);
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "▾";
                                color: #dbeafe;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        pos_touch := TouchArea {
                            clicked => {
                                root.insert_position_mode = (root.insert_position_mode >= 2) ? 0 : (root.insert_position_mode + 1);
                            }
                        }
                    }

                    Text {
                        text: ":";
                        color: #9ca3af;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }

                // 3. Category Tabs: [Cover] [Paper]
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 76px;
                        height: 32px;
                        border-radius: 8px;
                        background: (root.selected_paper_tab == 0) ? #3a3a42 : #232328;

                        Text {
                            text: "Cover";
                            color: (root.selected_paper_tab == 0) ? #ffffff : #9ca3af;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { root.selected_paper_tab = 0; }
                        }
                    }

                    Rectangle {
                        width: 76px;
                        height: 32px;
                        border-radius: 8px;
                        background: (root.selected_paper_tab == 1) ? #3a3a42 : #232328;
                        border-width: (root.selected_paper_tab == 1) ? 1px : 0px;
                        border-color: #52525b;

                        Text {
                            text: "Paper";
                            color: (root.selected_paper_tab == 1) ? #ffffff : #9ca3af;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { root.selected_paper_tab = 1; }
                        }
                    }
                }

                // 4. Template Cards Row: Current, Blank, Ruled, Grid, Dotted
                ScrollView {
                    height: 180px;

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        padding-left: 2px;
                        padding-right: 2px;

                        // Card 1: Current
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 110px;
                                height: 138px;
                                border-radius: 8px;
                                background: #ffffff;
                                border-width: root.selected_template_kind == 0 ? 3px : 1px;
                                border-color: root.selected_template_kind == 0 ? #007aff : #37373e;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #00000088;
                                clip: true;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.current_slide_image;
                                    image-fit: contain;
                                }

                                TouchArea {
                                    clicked => { root.selected_template_kind = 0; }
                                }
                            }

                            Text {
                                text: "Current";
                                color: root.selected_template_kind == 0 ? #60a5fa : #d1d5db;
                                font-size: 12px;
                                font-weight: root.selected_template_kind == 0 ? 700 : 500;
                                horizontal-alignment: center;
                            }
                        }

                        // Card 2: Blank
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 110px;
                                height: 138px;
                                border-radius: 8px;
                                background: root.get_paper_color(root.selected_paper_color_index);
                                border-width: root.selected_template_kind == 1 ? 3px : 1px;
                                border-color: root.selected_template_kind == 1 ? #007aff : #37373e;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #00000088;

                                TouchArea {
                                    clicked => { root.selected_template_kind = 1; }
                                }
                            }

                            Text {
                                text: "Blank";
                                color: root.selected_template_kind == 1 ? #60a5fa : #d1d5db;
                                font-size: 12px;
                                font-weight: root.selected_template_kind == 1 ? 700 : 500;
                                horizontal-alignment: center;
                            }
                        }

                        // Card 3: Ruled
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 110px;
                                height: 138px;
                                border-radius: 8px;
                                background: root.get_paper_color(root.selected_paper_color_index);
                                border-width: root.selected_template_kind == 2 ? 3px : 1px;
                                border-color: root.selected_template_kind == 2 ? #007aff : #37373e;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #00000088;
                                clip: true;

                                // Ruled lines
                                for i in 10: Rectangle {
                                    y: 18px + i * 11px;
                                    x: 8px;
                                    width: 94px;
                                    height: 1px;
                                    background: (root.selected_paper_color_index == 3 || root.selected_paper_color_index == 4) ? #52525b : #d1d5db;
                                }

                                // Margin line
                                Rectangle {
                                    x: 20px;
                                    y: 0px;
                                    width: 1px;
                                    height: 100%;
                                    background: (root.selected_paper_color_index == 3 || root.selected_paper_color_index == 4) ? #b91c1c88 : #ef444488;
                                }

                                // Options pill matching Presenter
                                Rectangle {
                                    x: 74px;
                                    y: 102px;
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 13px;
                                    background: #000000d0;
                                    border-width: 1px;
                                    border-color: #3b82f6;

                                    Text {
                                        text: "•••";
                                        font-size: 9px;
                                        color: #38bdf8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.selected_template_kind = 2; }
                                }
                            }

                            Text {
                                text: "Ruled";
                                color: root.selected_template_kind == 2 ? #60a5fa : #d1d5db;
                                font-size: 12px;
                                font-weight: root.selected_template_kind == 2 ? 700 : 500;
                                horizontal-alignment: center;
                            }
                        }

                        // Card 4: Grid
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 110px;
                                height: 138px;
                                border-radius: 8px;
                                background: root.get_paper_color(root.selected_paper_color_index);
                                border-width: root.selected_template_kind == 3 ? 3px : 1px;
                                border-color: root.selected_template_kind == 3 ? #007aff : #37373e;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #00000088;
                                clip: true;

                                for i in 12: Rectangle {
                                    y: i * 11px;
                                    x: 0px;
                                    width: 100%;
                                    height: 1px;
                                    background: (root.selected_paper_color_index == 3 || root.selected_paper_color_index == 4) ? #3f3f46 : #e5e7eb;
                                }
                                for j in 9: Rectangle {
                                    x: j * 12px;
                                    y: 0px;
                                    width: 1px;
                                    height: 100%;
                                    background: (root.selected_paper_color_index == 3 || root.selected_paper_color_index == 4) ? #3f3f46 : #e5e7eb;
                                }

                                TouchArea {
                                    clicked => { root.selected_template_kind = 3; }
                                }
                            }

                            Text {
                                text: "Grid";
                                color: root.selected_template_kind == 3 ? #60a5fa : #d1d5db;
                                font-size: 12px;
                                font-weight: root.selected_template_kind == 3 ? 700 : 500;
                                horizontal-alignment: center;
                            }
                        }

                        // Card 5: Dotted
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 110px;
                                height: 138px;
                                border-radius: 8px;
                                background: root.get_paper_color(root.selected_paper_color_index);
                                border-width: root.selected_template_kind == 4 ? 3px : 1px;
                                border-color: root.selected_template_kind == 4 ? #007aff : #37373e;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #00000088;
                                clip: true;

                                for row in 7: HorizontalLayout {
                                    y: 12px + row * 16px;
                                    x: 10px;
                                    spacing: 12px;
                                    for col in 6: Rectangle {
                                        width: 2px;
                                        height: 2px;
                                        border-radius: 1px;
                                        background: (root.selected_paper_color_index == 3 || root.selected_paper_color_index == 4) ? #71717a : #9ca3af;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.selected_template_kind = 4; }
                                }
                            }

                            Text {
                                text: "Dotted";
                                color: root.selected_template_kind == 4 ? #60a5fa : #d1d5db;
                                font-size: 12px;
                                font-weight: root.selected_template_kind == 4 ? 700 : 500;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // 5. "Other options" Section (Paper Background Color)
                Text {
                    text: "Other options";
                    font-size: 15px;
                    font-weight: 700;
                    color: #ffffff;
                }

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    // Color 0: Pure White (#ffffff)
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #ffffff;
                        border-width: root.selected_paper_color_index == 0 ? 3px : 1px;
                        border-color: root.selected_paper_color_index == 0 ? #007aff : #6b7280;

                        if root.selected_paper_color_index == 0: Text {
                            text: "✓";
                            color: #18181b;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea { clicked => { root.selected_paper_color_index = 0; } }
                    }

                    // Color 1: Warm Ivory / Cream (#fbf8eb)
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #fbf8eb;
                        border-width: root.selected_paper_color_index == 1 ? 3px : 1px;
                        border-color: root.selected_paper_color_index == 1 ? #007aff : #6b7280;

                        if root.selected_paper_color_index == 1: Text {
                            text: "✓";
                            color: #18181b;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea { clicked => { root.selected_paper_color_index = 1; } }
                    }

                    // Color 2: Legal Pad Yellow (#fef9c3)
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #fef9c3;
                        border-width: root.selected_paper_color_index == 2 ? 3px : 1px;
                        border-color: root.selected_paper_color_index == 2 ? #007aff : #6b7280;

                        if root.selected_paper_color_index == 2: Text {
                            text: "✓";
                            color: #18181b;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea { clicked => { root.selected_paper_color_index = 2; } }
                    }

                    // Color 3: Dark Slate / Charcoal (#18181b)
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #18181b;
                        border-width: root.selected_paper_color_index == 3 ? 3px : 1px;
                        border-color: root.selected_paper_color_index == 3 ? #007aff : #6b7280;

                        if root.selected_paper_color_index == 3: Text {
                            text: "✓";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea { clicked => { root.selected_paper_color_index = 3; } }
                    }

                    // Color 4: Chalkboard Green (#1e3a2f)
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #1e3a2f;
                        border-width: root.selected_paper_color_index == 4 ? 3px : 1px;
                        border-color: root.selected_paper_color_index == 4 ? #007aff : #6b7280;

                        if root.selected_paper_color_index == 4: Text {
                            text: "✓";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea { clicked => { root.selected_paper_color_index = 4; } }
                    }
                }

                // 6. Footer Actions: Cancel and Insert Page
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    // Cancel Button
                    Rectangle {
                        width: 90px;
                        height: 38px;
                        border-radius: 8px;
                        background: cancel_touch.has-hover ? #2e2e36 : #24242a;

                        Text {
                            text: "Cancel";
                            color: #d1d5db;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel_touch := TouchArea {
                            clicked => { root.show_insert_page_modal = false; }
                        }
                    }

                    // Insert Page Button
                    Rectangle {
                        width: 126px;
                        height: 38px;
                        border-radius: 8px;
                        background: insert_touch.has-hover ? #2563eb : #007aff;

                        Text {
                            text: "Insert Page";
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        insert_touch := TouchArea {
                            clicked => {
                                root.show_insert_page_modal = false;
                                root.insert_page_configured(
                                    root.insert_position_mode,
                                    root.selected_template_kind == 0 ? "current" : (
                                        root.selected_template_kind == 1 ? "blank" : (
                                            root.selected_template_kind == 2 ? "ruled" : (
                                                root.selected_template_kind == 3 ? "grid" : "dotted"
                                            )
                                        )
                                    ),
                                    root.get_paper_color(root.selected_paper_color_index)
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // --- Presenter OPTIONS & AUTO-UPDATER MODAL ---
    if root.show_updates_modal: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000bd;
        z: 999;

        // Backdrop click to dismiss
        TouchArea {
            clicked => {
                root.show_updates_modal = false;
            }
        }

        // Modal Dialog Box centered
        Rectangle {
            width: 530px;
            height: 480px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #18181b;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #2e2e34;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000ff;
            clip: true;

            // TouchArea inside modal to prevent closing when clicking inside dialog
            TouchArea { }

            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 20px;
                padding-left: 22px;
                padding-right: 22px;
                spacing: 14px;

                // 1. Header Bar: Icon, Title, and Close button
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        // App Icon Badge
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 7px;
                            background: #141416;
                            border-width: 1px;
                            border-color: #2e2e34;
                            clip: true;

                            Image {
                                source: @image-url("icons/app_icon.svg");
                                width: 22px;
                                height: 22px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: "PowerBeamer - Options & Updates";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Close ✕ Button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: updates_close_touch.has-hover ? #383840 : #26262c;

                        Image {
                            source: @image-url("icons/close.svg");
                            width: 13px;
                            height: 13px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #9ca3af;
                        }

                        updates_close_touch := TouchArea {
                            clicked => { root.show_updates_modal = false; }
                        }
                    }
                }

                // 2. Application Info Card
                Rectangle {
                    height: 74px;
                    background: #121214;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #27272b;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 14px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 10px;
                                background: #1c1c20;
                                border-width: 1px;
                                border-color: #2e2e34;
                                y: (parent.height - self.height) / 2;
                                clip: true;

                                Image {
                                    source: @image-url("icons/app_icon.svg");
                                    width: 36px;
                                    height: 36px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: "PowerBeamer";
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 800;
                                    }

                                    Rectangle {
                                        height: 18px;
                                        width: 52px;
                                        background: #2563eb26;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3b82f640;

                                        Text {
                                            text: "v" + root.app_version;
                                            color: #38bdf8;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: "LaTeX Beamer & PDF Presentation Studio";
                                    color: #9ca3af;
                                    font-size: 12px;
                                }
                            }
                        }

                        // GitHub Link Badge
                        Rectangle {
                            height: 28px;
                            width: 78px;
                            border-radius: 6px;
                            background: gh_link_touch.has-hover ? #2e2e36 : #1c1c20;
                            border-width: 1px;
                            border-color: #2e2e34;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: "GitHub ↗";
                                color: #38bdf8;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            gh_link_touch := TouchArea {
                                clicked => { root.open_external_url("https://github.com/ahmadikalkhorani/PowerBeamer"); }
                            }
                        }
                    }
                }

                // 3. Auto-Updater Status & Action Card
                Rectangle {
                    background: #141416;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #27272b;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        alignment: space-between;

                        // State A: Checking
                        if root.update_status == "checking": VerticalLayout {
                            alignment: center;
                            spacing: 8px;

                            Text {
                                text: "Connecting to GitHub Releases...";
                                color: #38bdf8;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Checking latest version for updates";
                                color: #6b7280;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }

                        // State B: Update Available
                        if root.update_status == "available": VerticalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "🎉 New Release Available: " + root.latest_version;
                                    color: #38bdf8;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                Rectangle {
                                    height: 20px;
                                    width: 90px;
                                    background: #10b98126;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #10b98160;

                                    Text {
                                        text: "Update Ready";
                                        color: #34d399;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Release notes box
                            Rectangle {
                                height: 75px;
                                background: #0d0d10;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272b;
                                clip: true;

                                Text {
                                    x: 8px;
                                    y: 8px;
                                    width: parent.width - 16px;
                                    text: root.release_notes;
                                    color: #d1d5db;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            // Download & Install Action Button
                            Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: install_touch.has-hover ? #1d4ed8 : #2563eb;

                                Text {
                                    text: "⬇  Download & Install Update Now";
                                    color: #ffffff;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                install_touch := TouchArea {
                                    clicked => { root.install_update(); }
                                }
                            }
                        }

                        // State C: Downloading
                        if root.update_status == "downloading": VerticalLayout {
                            alignment: center;
                            spacing: 10px;

                            Text {
                                text: "Downloading update package from GitHub...";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            // Progress Track
                            Rectangle {
                                height: 8px;
                                background: #27272b;
                                border-radius: 4px;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    height: 100%;
                                    width: max(8px, root.update_progress * parent.width);
                                    background: #3b82f6;
                                    border-radius: 4px;
                                }
                            }

                            Text {
                                text: Math.round(root.update_progress * 100.0) + "% completed";
                                color: #9ca3af;
                                font-size: 12px;
                                horizontal-alignment: right;
                            }
                        }

                        // State D: Ready to restart
                        if root.update_status == "ready": VerticalLayout {
                            alignment: center;
                            spacing: 10px;

                            Text {
                                text: "✓ Update installed successfully!";
                                color: #34d399;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Restart PowerBeamer to launch the newest version.";
                                color: #9ca3af;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: restart_touch.has-hover ? #059669 : #10b981;

                                Text {
                                    text: "🔄  Restart PowerBeamer Now";
                                    color: #ffffff;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                restart_touch := TouchArea {
                                    clicked => { root.restart_after_update(); }
                                }
                            }
                        }

                        // State E: Up to date or Idle
                        if root.update_status == "idle" || root.update_status == "up_to_date": VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 3px;

                                    Text {
                                        text: root.update_status == "up_to_date" ? "✓ PowerBeamer is up to date" : "Auto-Update via GitHub Releases";
                                        color: root.update_status == "up_to_date" ? #34d399 : #ffffff;
                                        font-size: 14px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Latest releases, security patches, and features";
                                        color: #6b7280;
                                        font-size: 12px;
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    width: 140px;
                                    border-radius: 8px;
                                    background: check_touch.has-hover ? #2e2e36 : #1f1f23;
                                    border-width: 1px;
                                    border-color: #3b82f6;

                                    Text {
                                        text: "Check for Updates";
                                        color: #38bdf8;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    check_touch := TouchArea {
                                        clicked => { root.check_for_updates(); }
                                    }
                                }
                            }
                        }

                        // State F: Error
                        if root.update_status == "error": VerticalLayout {
                            alignment: center;
                            spacing: 8px;

                            Text {
                                text: "Could not check for updates";
                                color: #f87171;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.update_status_message;
                                color: #9ca3af;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                width: 120px;
                                height: 30px;
                                border-radius: 6px;
                                background: retry_touch.has-hover ? #383842 : #222228;
                                border-width: 1px;
                                border-color: #3e3e48;

                                Text {
                                    text: "Retry Check";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                retry_touch := TouchArea {
                                    clicked => { root.check_for_updates(); }
                                }
                            }
                        }
                    }
                }

                // 4. Quick Actions Row
                HorizontalLayout {
                    spacing: 10px;

                    // Export PDF Button
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: exp_touch.has-hover ? #2e2e36 : #1e1e24;
                        border-width: 1px;
                        border-color: #2e2e34;

                        Text {
                            text: "💾  Export Annotated PDF";
                            color: #e5e7eb;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        exp_touch := TouchArea {
                            clicked => {
                                root.show_updates_modal = false;
                                root.export_pdf();
                            }
                        }
                    }

                    // Open PDF Button
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: open_touch.has-hover ? #2e2e36 : #1e1e24;
                        border-width: 1px;
                        border-color: #2e2e34;

                        Text {
                            text: "📂  Open New Presentation";
                            color: #e5e7eb;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        open_touch := TouchArea {
                            clicked => {
                                root.show_updates_modal = false;
                                root.open_pdf();
                            }
                        }
                    }
                }
            }
        }
    }

    // Floating Presentation Blankout / Whiteout / Screen Swap Indicator Banner
        if !root.is_end_of_show && (root.blank_mode != 0 || root.is_screen_swapped): Rectangle {
            x: (parent.width - self.width) / 2;
            y: 56px;
            width: 440px;
            height: 38px;
            border-radius: 8px;
            background: root.blank_mode == 1 ? #7f1d1d : (root.blank_mode == 2 ? #1e3a8a : #4c1d95);
            border-width: 1px;
            border-color: root.blank_mode == 1 ? #ef4444 : (root.blank_mode == 2 ? #3b82f6 : #8b5cf6);

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                Text {
                    text: root.blank_mode == 1 ? "◼ AUDIENCE SCREEN BLACKOUT (B to restore)" : (
                        root.blank_mode == 2 ? "◻ AUDIENCE SCREEN WHITEOUT (W to restore)" : "⇄ SCREENS SWAPPED (S to swap back)"
                    );
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: #ffffff22;
                    y: 8px;

                    Image {
                        source: @image-url("icons/close.svg");
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #ffffff;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.blank_mode != 0) {
                                root.blank_mode = 0;
                                root.toggle_blackout();
                            } else {
                                root.swap_screens();
                            }
                        }
                    }
                }
            }
        }

        // Slide-Out PDF Outline / TOC Drawer
        if root.show_toc_drawer: Rectangle {
            x: 0px;
            y: 48px;
            width: parent.width;
            height: parent.height - 48px;
            background: #00000088;

            // Semi-transparent backdrop click to dismiss
            TouchArea {
                clicked => { root.show_toc_drawer = false; }
            }

            // Left Drawer Panel
            Rectangle {
                x: 0px;
                y: 0px;
                width: 360px;
                height: parent.height;
                background: #18181b;
                border-width: 1px;
                border-color: #27272a;

                // Intercept clicks inside drawer panel so clicking empty space doesn't dismiss drawer
                TouchArea { }

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Drawer Header
                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "📑";
                                font-size: 16px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Document Outline & TOC";
                                color: #f3f4f6;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        // Close ✕ button
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: touch_close_toc.has-hover ? #27272a : transparent;

                            Image {
                                source: @image-url("icons/close.svg");
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: #9ca3af;
                            }

                            touch_close_toc := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_toc_drawer = false; }
                            }
                        }
                    }

                    // Divider
                    Rectangle {
                        height: 1px;
                        background: #27272a;
                    }

                    // Scrollable TOC Items List
                    ScrollView {
                        content-width: 328px;

                        VerticalLayout {
                            spacing: 4px;
                            padding-right: 4px;

                            for item in root.toc_items: Rectangle {
                                height: 38px;
                                border-radius: 6px;
                                background: item.is_active ? #2563eb33 : (item_touch.has-hover ? #27272a : transparent);
                                border-width: item.is_active ? 1px : 0px;
                                border-color: #3b82f6;

                                HorizontalLayout {
                                    padding-left: 8px + (item.level * 16px);
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        Text {
                                            text: item.level == 0 ? "▪" : "▫";
                                            color: item.is_active ? #60a5fa : #9ca3af;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: item.title;
                                            color: item.is_active ? #60a5fa : (item.level == 0 ? #f3f4f6 : #d1d5db);
                                            font-size: item.level == 0 ? 13px : 12px;
                                            font-weight: item.level == 0 ? 600 : 400;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Page & Frame Badge
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: item.is_active ? #1d4ed8 : #27272a;
                                        y: 9px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: "p." + item.page_index;
                                                color: item.is_active ? #ffffff : #9ca3af;
                                                font-size: 10px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                item_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show_toc_drawer = false;
                                        root.jump_to_toc(item.page_index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

    // Toast: transient status / error messages (load failures, sync results, missing media)
    if root.toast_visible: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 28px;
        z: 1000;
        width: min(toast_layout.preferred-width, root.width - 48px);
        height: toast_layout.preferred-height;
        border-radius: 8px;
        background: root.toast_is_error ? #3b1518f2 : #15291df2;
        border-width: 1px;
        border-color: root.toast_is_error ? #ef4444 : #22c55e;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000cc;

        toast_layout := HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 10px;
            Text {
                text: root.toast_text;
                color: root.toast_is_error ? #fecaca : #bbf7d0;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Rectangle {
                width: 18px;
                Image {
                    source: @image-url("icons/close.svg");
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: #a1a1aa;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toast_visible = false; }
                }
            }
        }
    }
}

// --- AUDIENCE VIEW (Clean display for Projector / External Monitor) ---
export component AudienceWindow inherits Window {
    title: "PowerBeamer - Audience View (Projector)";
    icon: @image-url("icons/app_icon.svg");
    min-width: 320px;
    min-height: 180px;
    background: #000000;

    in-out property <image> slide_image;
    in-out property <image> ink_image;
    // Laser trail layer: small image covering only the trail's bounding box (normalized rect)
    in-out property <image> laser_layer_image;
    in-out property <bool> laser_layer_visible: false;
    in-out property <[LaserBand]> laser_bands;
    in-out property <float> laser_layer_x: 0;
    in-out property <float> laser_layer_y: 0;
    in-out property <float> laser_layer_w: 0;
    in-out property <float> laser_layer_h: 0;
    in-out property <bool> laser_visible: false;
    in-out property <float> laser_x: 0.5;
    in-out property <float> laser_y: 0.5;
    in-out property <float> slide_aspect: 1.7778;
    in-out property <color> laser_color: #fef04e;
    in-out property <int> blank_mode: 0; // 0: Normal, 1: Blackout, 2: Whiteout
    in-out property <bool> is_end_of_show: false;

    // In-Place Video Player Properties for Audience View
    in-out property <image> video_frame_image;
    in-out property <bool> media_video_visible: false;
    in-out property <float> media_rect_x: 0.15;
    in-out property <float> media_rect_y: 0.26;
    in-out property <float> media_rect_w: 0.70;
    in-out property <float> media_rect_h: 0.50;

    // Pointer input on the audience slide, handled exactly like the presenter canvas
    callback canvas_pointer_down(float, float, float);
    callback canvas_pointer_move(float, float, float);
    callback canvas_pointer_up();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        property <length> avail_w: max(100px, self.width);
        property <length> avail_h: max(100px, self.height);
        property <float> aspect: root.slide_aspect > 0.1 ? root.slide_aspect : 1.7778;
        property <length> aud_w: (self.avail_w / 1px) / (self.avail_h / 1px) > self.aspect
            ? (self.avail_h * self.aspect)
            : self.avail_w;
        property <length> aud_h: (self.avail_w / 1px) / (self.avail_h / 1px) > self.aspect
            ? self.avail_h
            : (self.avail_w / self.aspect);

        Rectangle {
            width: parent.aud_w;
            height: parent.aud_h;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.slide_image;
                image-fit: fill;
            }

            // In-Place Video Display Layer for Audience
            if root.media_video_visible: Rectangle {
                x: root.media_rect_x * parent.width;
                y: root.media_rect_y * parent.height;
                width: root.media_rect_w * parent.width;
                height: root.media_rect_h * parent.height;
                background: #000000;
                border-radius: 0px;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.video_frame_image;
                    image-fit: fill;
                }
            }

            Image {
                width: 100%;
                height: 100%;
                source: root.ink_image;
                image-fit: fill;
            }

            // Interactive touch area for drawing / laser / eraser (tools are picked in the presenter view)
            TouchArea {
                mouse-cursor: MouseCursor.crosshair;
                pointer-event(event) => {
                    let norm_x = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                    let norm_y = max(0.0, min(1.0, (self.mouse-y / 1px) / (self.height / 1px)));
                    if (event.kind == PointerEventKind.down) {
                        root.canvas_pointer_down(norm_x, norm_y, 1.0);
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.canvas_pointer_up();
                    }
                }
                moved => {
                    let norm_x = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                    let norm_y = max(0.0, min(1.0, (self.mouse-y / 1px) / (self.height / 1px)));
                    root.canvas_pointer_move(norm_x, norm_y, self.pressed ? 1.0 : 0.0);
                }
            }

            LaserVectorTrail {
                width: 100%;
                height: 100%;
                bands: root.laser_bands;
                trail-color: root.laser_color;
            }

            if root.laser_layer_visible: Image {
                x: root.laser_layer_x * parent.width;
                y: root.laser_layer_y * parent.height;
                width: root.laser_layer_w * parent.width;
                height: root.laser_layer_h * parent.height;
                source: root.laser_layer_image;
                image-fit: fill;
            }

            if root.laser_visible: Rectangle {
                width: 32px;
                height: 32px;
                x: (root.laser_x * parent.width) - 16px;
                y: (root.laser_y * parent.height) - 16px;

                // 1. Broad atmospheric neon aura
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: root.laser_color.transparentize(0.82);
                }
                // 2. Concentrated saturated corona
                Rectangle {
                    x: 6px;
                    y: 6px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: root.laser_color.transparentize(0.35);
                }
                // 3. Dense core dot
                Rectangle {
                    x: 10px;
                    y: 10px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.laser_color;
                }
                // 4. White-hot filament center
                Rectangle {
                    x: 14px;
                    y: 14px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff;
                }
            }
        }

        // Projector Blankout / Whiteout Blanking Layer
        if root.blank_mode == 1 || root.is_end_of_show: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000;
        }
        if root.blank_mode == 2: Rectangle {
            width: 100%;
            height: 100%;
            background: #ffffff;
        }
    }
}

// --- DETACHED NOTES WINDOW (Floating for 3rd monitor or tablet) ---
export component NotesWindow inherits Window {
    title: "PowerBeamer - Speaker Notes (Detached)";
    icon: @image-url("icons/app_icon.svg");
    min-width: 280px;
    min-height: 300px;
    background: #18181b;

    in-out property <int> slide_num: 1;
    in-out property <int> total_slides: 10;
    in-out property <string> timer_str: "00:00";
    in-out property <string> notes_body: "";
    in-out property <image> mini_slide;
    in-out property <bool> has_notes_image: false;
    in-out property <bool> is_dual_screen: false;
    in-out property <image> notes_slide_image;
    in-out property <float> note_preview_ratio: 0.32;
    callback update_slide_notes(int, string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Slide " + root.slide_num + " of " + root.total_slides;
                color: #fafafa;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "⏱ " + root.timer_str;
                color: #10b981;
                font-size: 16px;
                font-weight: 700;
            }
        }

        // Preview Section: Dual-Screen Note Slide or Mini Slide Preview
        detached_preview_box := Rectangle {
            vertical-stretch: max(15, Math.round(root.note_preview_ratio * 100));
            min-height: 90px;
            background: #09090b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #27272a;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;

                    Text {
                        text: root.has_notes_image 
                            ? (root.is_dual_screen ? "📐 DUAL-SCREEN NOTE SLIDE (pgfpages)" : "📝 PRESENTER SPEAKER NOTE")
                            : "🖼 AUDIENCE SLIDE PREVIEW";
                        font-size: 11px;
                        font-weight: 700;
                        color: root.has_notes_image ? #34d399 : #93c5fd;
                    }

                    if root.has_notes_image: Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #064e3b;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: root.is_dual_screen ? "32:9 Split" : "Note Page";
                                font-size: 9px;
                                font-weight: 700;
                                color: #6ee7b7;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.has_notes_image ? root.notes_slide_image : root.mini_slide;
                        image-fit: contain;
                    }
                }
            }
        }

        // Draggable Horizontal Splitter Slider between Note Preview and Speaker Notes
        Rectangle {
            height: 12px;
            background: detached_h_splitter_touch.has-hover ? #2563eb22 : transparent;
            border-radius: 4px;

            Rectangle {
                height: 2px;
                width: 100%;
                y: 5px;
                background: detached_h_splitter_touch.has-hover ? #3b82f6 : #27272a;
            }

            Rectangle {
                width: 44px;
                height: 4px;
                y: 4px;
                x: (parent.width - self.width) / 2;
                border-radius: 2px;
                background: detached_h_splitter_touch.has-hover ? #60a5fa : #52525b;
            }

            detached_h_splitter_touch := TouchArea {
                mouse-cursor: row-resize;
                moved => {
                    if (self.pressed) {
                        let total_h = max(200px, detached_preview_box.height + detached_comments_box.height);
                        let current_mouse_h = detached_preview_box.height + self.mouse-y;
                        let new_ratio = max(0.15, min(0.70, (current_mouse_h / 1px) / (total_h / 1px)));
                        root.note_preview_ratio = new_ratio;
                    }
                }
            }
        }

        // Interactive Notes and Comments Area
        detached_comments_box := Rectangle {
            vertical-stretch: max(25, Math.round((1.0 - root.note_preview_ratio) * 100));
            min-height: 140px;
            background: #1c1c20;
            border-radius: 8px;
            border-width: 1px;
            border-color: #27272a;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "SPEAKER COMMENTS & NOTES";
                        color: #9ca3af;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: detached_btn_bullet.has-hover ? #374151 : #27272a;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "+ Bullet";
                                    font-size: 11px;
                                    color: #e5e7eb;
                                    vertical-alignment: center;
                                }
                            }
                            detached_btn_bullet := TouchArea {
                                clicked => {
                                    root.notes_body = root.notes_body + (root.notes_body == "" ? "• " : "\n• ");
                                    root.update_slide_notes(root.slide_num, root.notes_body);
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: detached_btn_rem.has-hover ? #374151 : #27272a;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "⏰ Reminder";
                                    font-size: 11px;
                                    color: #fbbf24;
                                    vertical-alignment: center;
                                }
                            }
                            detached_btn_rem := TouchArea {
                                clicked => {
                                    root.notes_body = root.notes_body + (root.notes_body == "" ? "⏰ Reminder: " : "\n⏰ Reminder: ");
                                    root.update_slide_notes(root.slide_num, root.notes_body);
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: detached_btn_clr.has-hover ? #451a1a : #27272a;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "Clear";
                                    font-size: 11px;
                                    color: #f87171;
                                    vertical-alignment: center;
                                }
                            }
                            detached_btn_clr := TouchArea {
                                clicked => {
                                    root.notes_body = "";
                                    root.update_slide_notes(root.slide_num, "");
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #141416;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: detached_input.has-focus ? #3b82f6 : #2e2e34;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 10px;

                            detached_input := TextInput {
                                text: root.notes_body;
                                color: #ffffff;
                                font-size: 14px;
                                wrap: word-wrap;
                                edited => {
                                    root.notes_body = self.text;
                                    root.update_slide_notes(root.slide_num, self.text);
                                }
                            }
                        }
                    }

                    if root.notes_body == "" && !detached_input.has-focus: Text {
                        x: 12px;
                        y: 12px;
                        text: "✍️ Type speaker comments, LaTeX derivations, or timing notes for this slide...";
                        color: #52525b;
                        font-size: 13px;
                    }
                }
            }
        }
    }
}

