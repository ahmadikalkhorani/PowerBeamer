import { ScrollView } from "std-widgets.slint";

export enum ActiveTool {
    Thumbnails,
    Pen,
    Highlighter,
    Eraser,
    Laser,
    Mic,
    AddPage,
    Undo,
    Redo,
}

export struct LaserBand {
    commands: string,
    intensity: float,
    radius: float,
}

// One glow pass of the vector laser trail. The Path is grown by the stroke width on every side
// because Slint insets the fitted path by half the stroke width.
component LaserPass inherits Rectangle {
    in property <string> commands;
    in property <brush> stroke;
    in property <length> stroke-px;
    width: 100%;
    height: 100%;

    Path {
        x: -root.stroke-px / 2;
        y: -root.stroke-px / 2;
        width: root.width + root.stroke-px;
        height: root.height + root.stroke-px;
        commands: root.commands;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: fill;
        stroke: root.stroke;
        stroke-width: root.stroke-px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Neon-tube laser trail drawn by the renderer: per brightness band, a soft halo, the
// saturated tube wall and a lighter filament core, all fading with the band's intensity.
// The core is a tint of the laser color, not pure white, so on white slides it never reads
// as a gap between two lines.
component LaserVectorTrail inherits Rectangle {
    in property <[LaserBand]> bands;
    in property <color> trail-color;
    // Trail radii are tuned for a 1600px-wide slide
    property <float> px-scale: self.width / 1600px;

    for band in root.bands: Rectangle {
        width: 100%;
        height: 100%;
        LaserPass { commands: band.commands; stroke: root.trail-color.with-alpha(band.intensity * 0.2); stroke-px: 1px * band.radius * 2.4 * 2 * root.px-scale; }
        LaserPass { commands: band.commands; stroke: root.trail-color.with-alpha(band.intensity); stroke-px: 1px * band.radius * 1.2 * 2 * root.px-scale; }
        LaserPass { commands: band.commands; stroke: root.trail-color.mix(#ffffff, 0.45).with-alpha(band.intensity); stroke-px: 1px * band.radius * 0.5 * 2 * root.px-scale; }
    }
}

export struct SlideThumbnail {
    index: int,
    image: image,
}

export struct TocItemModel {
    title: string,
    page_index: int,
    level: int,
    frame_index: int,
    is_active: bool,
}


component PresenterActionItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "";
    in property <bool> is_disabled: false;
    in property <bool> is_danger: false;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    background: is_disabled ? transparent : (touch.has-hover ? #2e2e34 : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.icon;
            color: root.is_disabled ? #4b5563 : (root.is_danger ? #f87171 : #d1d5db);
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.is_disabled ? #4b5563 : (root.is_danger ? #f87171 : #e5e7eb);
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
    }
}

component PresenterIconBtn inherits Rectangle {
    in property <bool> is_active: false;
    in property <string> shortcut: "";
    in property <string> tooltip_title: "";
    in property <string> tooltip_hint: "";
    callback clicked();
    callback right_clicked();

    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: is_active ? #2a2a30 : (touch.has-hover ? #26262a : transparent);
    z: touch.has-hover ? 100 : 0;

    animate background { duration: 100ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right_clicked();
            }
        }
    }

    @children

    // Floating Tooltip popping to the right of the toolbar
    if touch.has-hover && root.tooltip_title != "": Rectangle {
        width: icon_tooltip_layout.preferred-width;
        height: icon_tooltip_layout.preferred-height;
        x: 44px;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        background: #18181cf5;
        border-width: 1px;
        border-color: #3b82f670;
        drop-shadow-blur: 10px;
        drop-shadow-color: #000000bb;

        icon_tooltip_layout := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 3px;
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.tooltip_title;
                    font-size: 11px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }

                if root.shortcut != "": Rectangle {
                    height: 16px;
                    border-radius: 3px;
                    background: #27272a;
                    border-width: 1px;
                    border-color: #52525b;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: root.shortcut;
                            font-size: 9px;
                            font-weight: 800;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.tooltip_hint != "": Text {
                text: root.tooltip_hint;
                font-size: 9px;
                color: #9ca3af;
                vertical-alignment: center;
            }
        }
    }
}

component PresenterHeaderBtn inherits Rectangle {
    in property <bool> is_active: false;
    in property <color> active_bg: #2563eb;
    in property <color> active_border: #60a5fa;
    in property <string> shortcut: "";
    in property <string> tooltip_title: "";
    in property <string> tooltip_hint: "";
    in property <bool> align_right: false;
    callback clicked();

    width: 32px;
    height: 28px;
    border-radius: 6px;
    background: is_active ? active_bg : (touch.has-hover ? #2e2e34 : #1c1c1f);
    border-width: 1px;
    border-color: is_active ? active_border : #2e2e34;
    y: 10px;
    z: touch.has-hover ? 100 : 0;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    @children

    // Floating Tooltip below the header button
    if touch.has-hover && root.tooltip_title != "": Rectangle {
        width: tooltip_layout.preferred-width;
        height: tooltip_layout.preferred-height;
        x: align_right ? (parent.width - self.width) : ((parent.width - self.width) / 2);
        y: 34px;
        border-radius: 6px;
        background: #141416f8;
        border-width: 1px;
        border-color: #3b82f670;
        drop-shadow-blur: 10px;
        drop-shadow-color: #000000cc;

        tooltip_layout := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 3px;
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.tooltip_title;
                    font-size: 11px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }

                if root.shortcut != "": Rectangle {
                    height: 16px;
                    border-radius: 3px;
                    background: #27272a;
                    border-width: 1px;
                    border-color: #52525b;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: root.shortcut;
                            font-size: 9px;
                            font-weight: 800;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.tooltip_hint != "": Text {
                text: root.tooltip_hint;
                font-size: 9px;
                color: #9ca3af;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component PresenterColorSlot inherits Rectangle {
    in property <color> slot_color: #ffffff;
    in property <bool> is_active: false;
    in property <bool> is_popover_open: false;
    in property <string> slot_label: "Color Slot";
    in property <string> shortcut: "1";
    callback clicked();
    callback right_clicked();

    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: (is_active && is_popover_open) ? #2e2e32 : (touch.has-hover ? #2e2e32 : transparent);
    z: touch.has-hover ? 100 : 0;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right_clicked();
            }
        }
    }

    // Glow aura when active
    if is_active: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: slot_color.transparentize(0.55);
        drop-shadow-blur: 14px;
        drop-shadow-color: slot_color;
    }

    // Color Circle
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: is_active ? 22px : 18px;
        height: is_active ? 22px : 18px;
        border-radius: self.width / 2;
        background: slot_color;
        drop-shadow-blur: is_active ? 10px : 0px;
        drop-shadow-color: slot_color;
        border-width: is_active ? 1.5px : 0px;
        border-color: #ffffffd0;
    }

    // Hover tooltip popping to the right
    if touch.has-hover: Rectangle {
        width: color_tooltip_layout.preferred-width;
        height: color_tooltip_layout.preferred-height;
        x: 44px;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        background: #18181cf2;
        border-width: 1px;
        border-color: #3b82f670;
        drop-shadow-blur: 10px;
        drop-shadow-color: #000000bb;

        color_tooltip_layout := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 3px;
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.slot_label;
                    font-size: 11px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }

                if root.shortcut != "": Rectangle {
                    height: 16px;
                    border-radius: 3px;
                    background: #27272a;
                    border-width: 1px;
                    border-color: #52525b;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: root.shortcut;
                            font-size: 9px;
                            font-weight: 800;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "Click: Select • Right-click: Wheel";
                font-size: 9px;
                color: #9ca3af;
                vertical-alignment: center;
            }
        }
    }
}

component GridSwatch inherits Rectangle {
    in property <color> swatch_color;
    in property <bool> is_selected: false;
    callback clicked(color);

    background: swatch_color;
    border-width: is_selected ? 2px : 0px;
    border-color: (swatch_color == #ffffff || swatch_color == #e5e5ea || swatch_color == #ffff99 || swatch_color == #ccff99) ? #000000 : #ffffff;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.swatch_color); }
    }
}

component PresenterToggle inherits Rectangle {
    in-out property <bool> checked: true;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #007aff : #28282e;
    border-width: 1px;
    border-color: root.checked ? #007aff : #3a3a42;
    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Rectangle {
        x: root.checked ? 23px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000050;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component ToolSizeCard inherits Rectangle {
    in-out property <string> label: "";
    in-out property <length> dot_diameter: 8px;
    in-out property <bool> is_selected: false;
    callback clicked();

    horizontal-stretch: 1;
    min-width: 46px;
    height: 50px;
    border-radius: 11px;
    background: root.is_selected ? #252a38 : (touch.has-hover ? #24242d : #1b1b22);
    border-width: root.is_selected ? 1.5px : 1px;
    border-color: root.is_selected ? #0a84ff : (touch.has-hover ? #383846 : #2a2a34);
    drop-shadow-blur: root.is_selected ? 8px : 0px;
    drop-shadow-color: root.is_selected ? #0a84ff35 : transparent;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    VerticalLayout {
        alignment: center;
        spacing: 5px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.dot_diameter;
                height: root.dot_diameter;
                border-radius: root.dot_diameter / 2;
                background: #ffffff;
            }
        }

        if root.label != "": Text {
            text: root.label;
            font-size: 9.5px;
            font-weight: root.is_selected ? 600 : 500;
            color: root.is_selected ? #ffffff : #8e8e9a;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PresenterWindow inherits Window {
    title: "PowerBeamer - " + root.document_title;
    icon: @image-url("icons/app_icon.svg");
    min-width: 800px;
    min-height: 560px;
    background: #18181a;

    in-out property <string> document_title: "Interactive Beamer Presentation.pdf";
    in-out property <ActiveTool> current_tool: ActiveTool.Laser;
    in-out property <color> active_color: #fef04e;
    in-out property <length> stroke_width: 3.5px;
    in-out property <int> current_slide: 1;
    in-out property <int> total_slides: 10;
    in-out property <string> elapsed_time: "00:00";
    in-out property <string> remaining_time: "45:00";
    in-out property <string> wall_clock: "10:45 AM";
    in-out property <bool> timer_running: true;
    in-out property <string> notes_text: "LaTeX Beamer Notes:\n• Key takeaway: asymptotic complexity is O(N log N)\n• Emphasize theorem 3.2 on next transition";
    in-out property <image> current_slide_image;
    in-out property <image> next_slide_image;
    in-out property <bool> has_notes_image: false;
    in-out property <bool> is_dual_screen: false;
    in-out property <image> notes_slide_image;
    in-out property <image> ink_overlay_image;
    // Laser trail layer: small image covering only the trail's bounding box (normalized rect)
    in-out property <image> laser_layer_image;
    in-out property <bool> laser_layer_visible: false;
    in-out property <[LaserBand]> laser_bands;
    in-out property <float> laser_layer_x: 0;
    in-out property <float> laser_layer_y: 0;
    in-out property <float> laser_layer_w: 0;
    in-out property <float> laser_layer_h: 0;
    in-out property <bool> laser_active: false;
    in-out property <float> laser_x: 0.5;
    in-out property <float> laser_y: 0.5;
    in-out property <string> render_quality: "Ultra Vector (600 DPI)";
    in-out property <bool> audience_window_open: false;
    in-out property <bool> notes_window_open: false;
    in-out property <bool> notes_drawer_open: false;
    in-out property <float> notes_split_ratio: 0.32; // Fraction of workspace width allocated to notes panel (0.15 - 0.70)
    in-out property <float> note_preview_ratio: 0.30; // Fraction of drawer height allocated to note slide preview (0.15 - 0.70)
    in-out property <bool> show_thumbnails: false;
    in-out property <[SlideThumbnail]> slide_thumbnails: [];
    in-out property <int> dragging_page_index: 0; // 1-based index of dragged slide (0 if none)
    in-out property <int> drag_target_index: 0; // 1-based target insertion slot
    in-out property <length> drag_offset_x: 0px;
    in-out property <length> drag_offset_y: 0px;
    in-out property <length> drag_start_mouse_x: 0px;
    in-out property <length> drag_start_mouse_y: 0px;
    in-out property <image> dragging_slide_image;
    in-out property <bool> is_dragging_page: false;
    in-out property <bool> select_mode: false;
    in-out property <bool> show_color_popover: false;
    in-out property <int> active_color_slot: 0; // 0, 1, 2, 3, 4
    in-out property <color> color_slot_1: #fef04e; // Yellow
    in-out property <color> color_slot_2: #5da638; // Green
    in-out property <color> color_slot_3: #5e35f7; // Purple
    in-out property <color> color_slot_4: #ef4444; // Coral Red
    in-out property <color> color_slot_5: #00c5ff; // Sky Blue
    in-out property <int> color_tab_index: 0; // 0: Grid, 1: Wheel, 2: Palettes, 3: Style
    in-out property <[color]> custom_palette: [ #fef04e, #5da638, #5e35f7, #ef4444, #00c5ff ];
    in-out property <float> wheel_hue: 60.0;
    in-out property <float> wheel_sat: 1.0;
    in-out property <float> wheel_val: 1.0;
    in-out property <color> wheel_pure_color: #fef04e;
    in-out property <length> wheel_thumb_x: 60px;
    in-out property <length> wheel_thumb_y: 10px;
    in-out property <bool> show_pen_popover: false;
    in-out property <int> pen_popover_tab: 0; // 0: Presets, 1: Settings
    in-out property <bool> auto_shape_enabled: true;
    in-out property <bool> scribble_to_erase: true;
    in-out property <float> hold_delay_s: 0.5;
    in-out property <string> hold_delay_text: "0.5s";
    in-out property <bool> enhanced_sensitivity: true;
    in-out property <bool> draw_on_hover: true;
    in-out property <int> pen_type: 1; // 0: Fineliner, 1: Fountain, 2: Marker
    in-out property <string> pen_size_mm: "0.8mm";
    in-out property <float> pen_size_value: 0.8;
    in-out property <bool> current_has_media: false;
    in-out property <string> media_status_text: "";
    in-out property <bool> media_playing: false;
    in-out property <float> media_progress: 0.0;
    in-out property <string> media_time_text: "00:00 / 01:30";
    in-out property <string> media_speed_text: "1.0x";
    in-out property <bool> media_speech_active: true;
    in-out property <int> media_clip_count: 0;
    in-out property <int> media_clip_index: 0;
    in-out property <float> slide_aspect: 1.7778;
    in-out property <bool> is_recording: false;

    // In-Place Video Player Properties
    in-out property <image> video_frame_image;
    in-out property <bool> media_video_visible: false;
    in-out property <float> media_rect_x: 0.15;
    in-out property <float> media_rect_y: 0.26;
    in-out property <float> media_rect_w: 0.70;
    in-out property <float> media_rect_h: 0.50;

    // Draggable Floating Media Controller Properties
    in-out property <length> media_ctrl_x: -1px;
    in-out property <length> media_ctrl_y: -1px;
    property <length> media_drag_anchor_x: 0px;
    property <length> media_drag_anchor_y: 0px;

    // Highlighter Properties (from Presenter Screenshot)
    in-out property <bool> show_highlighter_popover: false;
    in-out property <int> highlighter_mode: 0; // 0: Highlighter, 1: Tape
    in-out property <string> highlighter_size_mm: "4.6mm";
    in-out property <float> highlighter_size_value: 4.6;
    in-out property <bool> highlighter_straight_lines: false;

    // Eraser Properties (from Presenter Screenshot)
    in-out property <bool> show_eraser_popover: false;
    in-out property <int> eraser_size_index: 2; // 0..4 (2 is default medium)
    in-out property <float> eraser_radius: 0.04;
    in-out property <bool> erase_whole_line: false;
    in-out property <bool> erase_highlight_only: false;
    in-out property <bool> auto_select_previous_tool: false;
    in-out property <bool> erase_shapes: true;
    in-out property <bool> erase_tapes: false;

    // Laser Pointer Properties (from Presenter Screenshot)
    in-out property <bool> show_laser_popover: false;
    in-out property <int> laser_color_index: 0; // 0: Red, 1: Blue, 2: Green, 3: Purple
    in-out property <color> laser_color: root.active_color;
    in-out property <bool> laser_draw_lines: true;
    in-out property <float> laser_fade_duration_s: 1.8;
    in-out property <string> laser_fade_duration_text: "1.8s";

    // Presentation Mode & Screen Control Properties
    in-out property <int> blank_mode: 0; // 0: Normal, 1: Blackout, 2: Whiteout
    in-out property <bool> is_end_of_show: false;
    in-out property <bool> is_screen_swapped: false;
    in-out property <int> current_frame: 1;
    in-out property <int> total_frames: 1;
    in-out property <int> overlay_step: 1;
    in-out property <int> overlay_total: 1;
    in-out property <string> frame_info_text: "";
    in-out property <bool> show_toc_drawer: false;
    in-out property <[TocItemModel]> toc_items: [];

    // PDF Interactive Links Properties
    in-out property <bool> hovered_on_link: false;
    in-out property <string> hovered_link_tooltip: "";
    in-out property <bool> link_holding: false;
    in-out property <float> link_hold_progress: 0.0;

    callback play_media();
    callback pause_media();
    callback stop_media();
    callback toggle_media_playback();
    callback seek_media(float);
    callback toggle_media_speed();
    callback toggle_media_speech();
    callback select_media_clip(int);
    callback tool_selected(ActiveTool);
    callback color_changed(color);
    callback color_wheel_touched(length, length);
    callback color_brightness_touched(float);
    callback width_changed(length);
    callback next_slide();
    callback prev_slide();
    callback jump_to_slide(int);
    callback next_frame();
    callback prev_frame();
    callback toggle_blackout();
    callback toggle_whiteout();
    callback swap_screens();
    callback toggle_toc();
    callback jump_to_toc(int);
    callback add_whiteboard_page();
    callback delete_slide(int);
    callback duplicate_slide(int);
    callback rotate_slide(int);
    callback undo();
    callback redo();
    callback toggle_timer();
    callback reset_timer();
    callback toggle_audience_window();
    callback toggle_notes_window();
    callback update_slide_notes(int, string);
    callback quality_changed(string);
    callback canvas_pointer_down(float, float, float);
    callback canvas_pointer_move(float, float, float);
    callback canvas_pointer_up();
    callback export_pdf();
    callback open_pdf();
    in-out property <bool> deck_loading: false;
    in-out property <bool> toast_visible: false;
    in-out property <string> toast_text: "";
    in-out property <bool> toast_is_error: false;
    // Auto-reload the deck when the source PDF changes on disk (e.g. after a LaTeX rebuild)
    in-out property <bool> sync_with_source: true;
    in-out property <bool> has_source_file: false;
    in-out property <string> sync_status_text: "";
    callback toggle_sync_with_source(bool);

    // Pen Tool Callbacks
    callback toggle_auto_shape(bool);
    callback toggle_scribble_to_erase(bool);
    callback change_hold_delay(float);
    callback toggle_enhanced_sensitivity(bool);
    callback toggle_draw_on_hover(bool);
    callback select_pen_type(int);
    callback select_pen_size(float, string);

    // Highlighter Tool Callbacks
    callback select_highlighter_mode(int);
    callback select_highlighter_size(float, string);
    callback toggle_highlighter_straight_lines(bool);

    // Eraser Tool Callbacks
    callback select_eraser_size(int, float);
    callback toggle_erase_whole_line(bool);
    callback toggle_erase_highlight_only(bool);
    callback toggle_auto_select_previous_tool(bool);
    callback toggle_erase_shapes(bool);
    callback toggle_erase_tapes(bool);
    callback reset_eraser_settings();

    // Laser Pointer Tool Callbacks
    callback select_laser_color(int, color);
    callback toggle_laser_draw_lines(bool);
    callback change_laser_fade_duration(float);

    // Color Swatch & Palette Callbacks
    callback add_custom_color(color);

    // Auto-Updater & Software Releases
    in-out property <string> app_version: "0.1.0";
    in-out property <bool> show_updates_modal: false;
    in-out property <string> update_status: "idle"; // "idle", "checking", "available", "downloading", "ready", "error", "up_to_date"
    in-out property <string> update_status_message: "";
    in-out property <string> latest_version: "";
    in-out property <string> release_notes: "";
    in-out property <string> release_url: "";
    in-out property <float> update_progress: 0.0;
    in-out property <bool> update_available_badge: false;

    callback check_for_updates();
    callback install_update();
    callback restart_after_update();
    callback open_external_url(string);

    // Insert Page & Slide Reorder (Presenter style)
    in-out property <bool> show_insert_page_modal: false;
    in-out property <int> insert_position_mode: 0; // 0: After current page, 1: Before current page, 2: At the end
    in-out property <int> selected_template_kind: 1; // 0: Current, 1: Blank, 2: Ruled, 3: Grid, 4: Dotted
    in-out property <int> selected_paper_tab: 1; // 0: Cover, 1: Paper
    in-out property <int> selected_paper_color_index: 1; // 0: White, 1: Ivory, 2: Yellow, 3: Dark, 4: Green

    callback move_slide(int, int); // from_slide (1-based), to_slide (1-based)
    callback insert_page_configured(int, string, color); // position_mode, template_kind, bg_color

    pure function get_paper_color(idx: int) -> color {
        if (idx == 0) {
            return #ffffff;
        } else if (idx == 1) {
            return #fbf8eb;
        } else if (idx == 2) {
            return #fef9c3;
        } else if (idx == 3) {
            return #18181b;
        } else if (idx == 4) {
            return #1e3a2f;
        }
        return #ffffff;
    }

    pure function get_position_name(mode: int) -> string {
        if (mode == 0) {
            return "After current page";
        } else if (mode == 1) {
            return "Before current page";
        } else {
            return "At the end";
        }
    }

    function select_color_internal(c: color) {
        root.active_color = c;
        if (root.active_color_slot == 0) { root.color_slot_1 = c; }
        else if (root.active_color_slot == 1) { root.color_slot_2 = c; }
        else if (root.active_color_slot == 2) { root.color_slot_3 = c; }
        else if (root.active_color_slot == 3) { root.color_slot_4 = c; }
        else if (root.active_color_slot == 4) { root.color_slot_5 = c; }
        root.color_changed(c);
    }

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.show_toc_drawer) {
                    root.show_toc_drawer = false;
                    accept
                } else if (root.show_updates_modal) {
                    root.show_updates_modal = false;
                    accept
                } else if (root.show_insert_page_modal) {
                    root.show_insert_page_modal = false;
                    accept
                } else if (root.show_laser_popover) {
                    root.show_laser_popover = false;
                    accept
                } else if (root.show_eraser_popover) {
                    root.show_eraser_popover = false;
                    accept
                } else if (root.show_highlighter_popover) {
                    root.show_highlighter_popover = false;
                    accept
                } else if (root.show_pen_popover) {
                    root.show_pen_popover = false;
                    accept
                } else if (root.show_color_popover) {
                    root.show_color_popover = false;
                    accept
                } else if (root.show_thumbnails) {
                    root.show_thumbnails = false;
                    accept
                } else if (root.media_playing || root.media_video_visible) {
                    root.stop_media();
                    accept
                } else if (root.is_end_of_show) {
                    root.prev_slide();
                    accept
                } else {
                    reject
                }
            } else if (event.text == "b" || event.text == "B") {
                root.toggle_blackout();
                accept
            } else if (event.text == "w" || event.text == "W") {
                root.toggle_whiteout();
                accept
            } else if (event.text == "s" || event.text == "S") {
                root.swap_screens();
                accept
            } else if (event.text == "j" || event.text == "J") {
                root.next_frame();
                accept
            } else if (event.text == "k" || event.text == "K") {
                root.prev_frame();
                accept
            } else if (event.text == "o" || event.text == "O") {
                root.toggle_toc();
                accept
            } else if (event.text == "l" || event.text == "L") {
                root.current_tool = ActiveTool.Laser;
                root.laser_color = root.active_color;
                root.tool_selected(ActiveTool.Laser);
                root.show_laser_popover = false;
                root.show_eraser_popover = false;
                root.show_pen_popover = false;
                root.show_highlighter_popover = false;
                root.show_color_popover = false;
                accept
            } else if (event.text == "p" || event.text == "P") {
                root.current_tool = ActiveTool.Pen;
                root.tool_selected(ActiveTool.Pen);
                root.show_pen_popover = false;
                root.show_highlighter_popover = false;
                root.show_eraser_popover = false;
                root.show_laser_popover = false;
                root.show_color_popover = false;
                accept
            } else if (event.text == "h" || event.text == "H") {
                root.current_tool = ActiveTool.Highlighter;
                root.tool_selected(ActiveTool.Highlighter);
                root.show_pen_popover = false;
                root.show_highlighter_popover = false;
                root.show_eraser_popover = false;
                root.show_laser_popover = false;
                root.show_color_popover = false;
                accept
            } else if (event.text == "e" || event.text == "E") {
                root.current_tool = ActiveTool.Eraser;
                root.tool_selected(ActiveTool.Eraser);
                root.show_pen_popover = false;
                root.show_highlighter_popover = false;
                root.show_eraser_popover = false;
                root.show_laser_popover = false;
                root.show_color_popover = false;
                accept

            } else if (event.text == "t" || event.text == "T") {
                root.show_thumbnails = !root.show_thumbnails;
                accept
            } else if (event.text == "m" || event.text == "M") {
                root.toggle_media_playback();
                accept
            } else if (event.text == "1") {
                root.active_color_slot = 0;
                root.active_color = root.color_slot_1;
                root.color_changed(root.color_slot_1);
                accept
            } else if (event.text == "2") {
                root.active_color_slot = 1;
                root.active_color = root.color_slot_2;
                root.color_changed(root.color_slot_2);
                accept
            } else if (event.text == "3") {
                root.active_color_slot = 2;
                root.active_color = root.color_slot_3;
                root.color_changed(root.color_slot_3);
                accept
            } else if (event.text == "4") {
                root.active_color_slot = 3;
                root.active_color = root.color_slot_4;
                root.color_changed(root.color_slot_4);
                accept
            } else if (event.text == "5") {
                root.active_color_slot = 4;
                root.active_color = root.color_slot_5;
                root.color_changed(root.color_slot_5);
                accept
            } else if (event.text == " " || event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == Key.PageDown || event.text == Key.Return || event.text == "Right" || event.text == "Down" || event.text == "PageDown" || event.text == "Return") {
                root.next_slide();
                accept
            } else if (event.text == Key.LeftArrow || event.text == Key.UpArrow || event.text == Key.PageUp || event.text == Key.Backspace || event.text == "Left" || event.text == "Up" || event.text == "PageUp" || event.text == "Backspace") {
                root.prev_slide();
                accept
            } else if (event.text == "n" || event.text == "N" || event.text == "+") {
                root.add_whiteboard_page();
                accept
            } else if (event.text == "z" && (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift) {
                root.undo();
                accept
            } else if ((event.text == "y" || (event.text == "z" && event.modifiers.shift)) && (event.modifiers.control || event.modifiers.meta)) {
                root.redo();
                accept
            } else {
                reject
            }
        }
    }

    // MAIN LAYOUT
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // --- Presenter TOP BAR ---
        Rectangle {
            height: 48px;
            background: #202023;
            border-width: 1px;
            border-color: #2b2b2f;
            z: 100;

            // Presenter PAGE OVERVIEW HEADER (When show_thumbnails is true)
            if root.show_thumbnails: HorizontalLayout {
                padding-left: 14px;
                padding-right: 18px;
                alignment: space-between;

                // Left: App Icon, Blue Close ✕, Undo, Redo
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Presenter App Icon Badge
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: #141416;
                        border-width: 1px;
                        border-color: #2e2e34;
                        y: 10px;
                        clip: true;

                        Image {
                            source: @image-url("icons/app_icon.svg");
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // Close button (Blue)
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 6px;
                        background: touch-exit-grid.has-hover ? #2e2e34 : transparent;
                        y: 9px;
                        Image {
                            source: @image-url("icons/close.svg");
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #007aff;
                        }
                        touch-exit-grid := TouchArea {
                            clicked => { root.show_thumbnails = false; }
                        }
                    }

                    // Undo
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: touch-ov-undo.has-hover ? #2e2e34 : transparent;
                        y: 10px;
                        Image {
                            source: @image-url("icons/undo.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #9ca3af;
                        }
                        touch-ov-undo := TouchArea {
                            clicked => { root.undo(); }
                        }
                    }

                    // Redo
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: touch-ov-redo.has-hover ? #2e2e34 : transparent;
                        y: 10px;
                        Image {
                            source: @image-url("icons/redo.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #9ca3af;
                        }
                        touch-ov-redo := TouchArea {
                            clicked => { root.redo(); }
                        }
                    }
                }

                // Center: Document Title
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.document_title;
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Right: Blue "Select" button
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: touch-select.has-hover ? #1e293b : transparent;
                        y: 9px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: root.select_mode ? "Done" : "Select";
                                color: #007aff;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        touch-select := TouchArea {
                            clicked => { root.select_mode = !root.select_mode; }
                        }
                    }
                }
            }

            // STANDARD PRESENTATION HEADER (When show_thumbnails is false)
            if !root.show_thumbnails: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                // Left: App Icon, Back < , Close x , Document title
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    // Presenter App Icon Badge
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: #141416;
                        border-width: 1px;
                        border-color: #2e2e34;
                        y: 10px;
                        clip: true;

                        Image {
                            source: @image-url("icons/app_icon.svg");
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // Open PDF / Choose Presentation button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: touch-folder.has-hover ? #2e2e34 : transparent;
                        y: 10px;
                        Image {
                            source: @image-url("icons/folder_open.svg");
                            width: 17px;
                            height: 17px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: touch-folder.has-hover ? #ffffff : #9ca3af;
                        }
                        touch-folder := TouchArea {
                            clicked => { root.open_pdf(); }
                        }
                    }

                    // Document Title pill (e.g. 2202-SRP-DNN)
                    Rectangle {
                        height: 28px;
                        background: #141416;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #2e2e34;
                        y: 10px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: root.document_title;
                                color: #e5e7eb;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Center: Slide Counter & Presentation Timers
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    // Slide Counter Pill
                    // Slide Counter Pill with Interactive Previous / Next Arrows
                    Rectangle {
                        height: 28px;
                        background: #141416;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #2e2e34;
                        y: 10px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            // Previous Slide Arrow (‹)
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: touch_prev_slide.has-hover ? #2e2e34 : transparent;
                                opacity: (root.current_slide > 1 || root.is_end_of_show) ? 1.0 : 0.35;
                                y: 4px;

                                Text {
                                    text: "‹";
                                    color: #9ca3af;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch_prev_slide := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.prev_slide(); }
                                }
                            }

                            // Slide Counter Text (e.g. 1 / 2)
                            Text {
                                text: root.is_end_of_show ? ("End / " + root.total_slides) : (root.current_slide + " / " + root.total_slides);
                                color: root.is_end_of_show ? #f87171 : #f3f4f6;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            // Next Slide Arrow (›)
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: touch_next_slide.has-hover ? #2e2e34 : transparent;
                                opacity: root.is_end_of_show ? 0.35 : 1.0;
                                y: 4px;

                                Text {
                                    text: "›";
                                    color: #9ca3af;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch_next_slide := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.next_slide(); }
                                }
                            }
                        }
                    }

                    // Beamer Logical Frame & Overlay Indicator Pill (e.g. Frame 2/5 • Step 1/3)
                    if root.frame_info_text != "": Rectangle {
                        height: 28px;
                        background: #141824;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #3b82f6;
                        y: 10px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 5px;
                            alignment: center;

                            // Previous Frame Arrow (⏮)
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: touch_prev_frame.has-hover ? #2e2e34 : transparent;
                                y: 5px;

                                Text {
                                    text: "⏮";
                                    color: #60a5fa;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch_prev_frame := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.prev_frame(); }
                                }
                            }

                            Text {
                                text: root.frame_info_text;
                                color: #93c5fd;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            // Next Frame Arrow (⏭)
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: touch_next_frame.has-hover ? #2e2e34 : transparent;
                                y: 5px;

                                Text {
                                    text: "⏭";
                                    color: #60a5fa;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch_next_frame := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.next_frame(); }
                                }
                            }
                        }
                    }

                    // Timer Pill
                    Rectangle {
                        height: 28px;
                        background: #141416;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #2e2e34;
                        y: 10px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: "⏱ " + root.elapsed_time;
                                color: #10b981;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.toggle_timer(); } }
                    }

                    // Recording Indicator Pill
                    if root.is_recording: Rectangle {
                        height: 28px;
                        background: #7f1d1d;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #ef4444;
                        y: 10px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 4px;
                            Text {
                                text: "● REC";
                                color: #fca5a5;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.is_recording = false; } }
                    }
                }

                // Right: View Mode, Pop Audience, Pop Notes, Export
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Source PDF Sync Pill (reload deck when the original PDF is rebuilt)
                    if root.has_source_file: Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: touch_sync.has-hover ? #1a2e23 : #16201a;
                        border-width: 1.5px;
                        border-color: root.sync_with_source ? #16a34a : #3a3a42;
                        y: 10px;
                        z: touch_sync.has-hover ? 100 : 0;

                        width: 28px;
                        Image {
                            source: root.sync_with_source ? @image-url("icons/sync.svg") : @image-url("icons/sync_off.svg");
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.deck_loading ? #fbbf24 : root.sync_with_source ? #4ade80 : #9ca3af;
                        }
                        touch_sync := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.sync_with_source = !root.sync_with_source;
                                root.toggle_sync_with_source(root.sync_with_source);
                            }
                        }

                        if touch_sync.has-hover: Rectangle {
                            width: sync_tooltip_layout.preferred-width;
                            height: sync_tooltip_layout.preferred-height;
                            x: (parent.width - self.width) / 2;
                            y: 34px;
                            border-radius: 6px;
                            background: #141416f5;
                            border-width: 1px;
                            border-color: #16a34a70;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #000000cc;

                            sync_tooltip_layout := VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 3px;
                                Text {
                                    text: root.sync_with_source ? "Sync with Source PDF: On" : "Sync with Source PDF: Off";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                Text {
                                    text: root.sync_with_source
                                        ? "Reloads slides when the PDF is rebuilt. Ink is kept."
                                        : "Click to reload automatically when the PDF changes.";
                                    font-size: 10px;
                                    color: #a1a1aa;
                                }
                                if root.sync_status_text != "": Text {
                                    text: root.sync_status_text;
                                    font-size: 10px;
                                    color: #4ade80;
                                }
                            }
                        }
                    }

                    // Render Quality Indicator Pill (Interactive Ultra / Balanced / Eco)
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: touch_qual.has-hover ? #1e293b : #181c24;
                        border-width: 1.5px;
                        border-color: #2563eb;
                        y: 10px;
                        z: touch_qual.has-hover ? 100 : 0;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: root.render_quality;
                                color: #60a5fa;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        touch_qual := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.render_quality == "Ultra Vector (600 DPI)") {
                                    root.render_quality = "Balanced (300 DPI)";
                                } else if (root.render_quality == "Balanced (300 DPI)") {
                                    root.render_quality = "Eco Battery (150 DPI)";
                                } else {
                                    root.render_quality = "Ultra Vector (600 DPI)";
                                }
                                root.quality_changed(root.render_quality);
                            }
                        }

                        if touch_qual.has-hover: Rectangle {
                            width: qual_tooltip_layout.preferred-width;
                            height: qual_tooltip_layout.preferred-height;
                            x: (parent.width - self.width) / 2;
                            y: 34px;
                            border-radius: 6px;
                            background: #141416f5;
                            border-width: 1px;
                            border-color: #3b82f670;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #000000cc;

                            qual_tooltip_layout := VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 3px;
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    Text {
                                        text: "PDF Rendering Quality";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        height: 16px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        border-width: 1px;
                                        border-color: #52525b;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            Text {
                                                text: "Click to cycle";
                                                font-size: 9px;
                                                font-weight: 800;
                                                color: #60a5fa;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: "Ultra Vector (600 DPI) • Balanced (300 DPI) • Eco (150 DPI)";
                                    font-size: 9px;
                                    color: #9ca3af;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Screen Blackout Button (B)
                    PresenterHeaderBtn {
                        is_active: root.blank_mode == 1;
                        active_bg: #dc2626;
                        active_border: #ef4444;
                        tooltip_title: "Screen Blackout";
                        shortcut: "B";
                        tooltip_hint: "Black out audience screen to focus attention on speaker";
                        clicked => { root.toggle_blackout(); }

                        Image {
                            source: @image-url("icons/blackout.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.blank_mode == 1 ? root.active_color : #ffffff;
                        }
                    }

                    // Screen Whiteout Button (W)
                    PresenterHeaderBtn {
                        is_active: root.blank_mode == 2;
                        active_bg: #2563eb;
                        active_border: #60a5fa;
                        tooltip_title: "Screen Whiteout";
                        shortcut: "W";
                        tooltip_hint: "Whiteout screen for annotations & reflections";
                        clicked => { root.toggle_whiteout(); }

                        Image {
                            source: @image-url("icons/whiteout.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.blank_mode == 2 ? root.active_color : #ffffff;
                        }
                    }

                    // Screen Swap Button (S)
                    PresenterHeaderBtn {
                        is_active: root.is_screen_swapped;
                        active_bg: #7c3aed;
                        active_border: #a78bfa;
                        tooltip_title: "Swap Displays";
                        shortcut: "Swap";
                        tooltip_hint: "Swap Presenter and Audience screen output";
                        clicked => { root.swap_screens(); }

                        Image {
                            source: @image-url("icons/swap_screens.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.is_screen_swapped ? root.active_color : #ffffff;
                        }
                    }

                    // Document Outline / TOC Drawer Button (O)
                    PresenterHeaderBtn {
                        align_right: true;
                        is_active: root.show_toc_drawer;
                        active_bg: #2563eb;
                        active_border: #60a5fa;
                        tooltip_title: "Table of Contents";
                        shortcut: "O";
                        tooltip_hint: "Toggle PDF outline and bookmarks drawer";
                        clicked => { root.toggle_toc(); }

                        Image {
                            source: @image-url("icons/toc.svg");
                            width: 17px;
                            height: 17px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.show_toc_drawer ? root.active_color : #ffffff;
                        }
                    }

                    // Audience Projector Popout Button
                    PresenterHeaderBtn {
                        align_right: true;
                        is_active: root.audience_window_open;
                        active_bg: #2563eb;
                        active_border: #60a5fa;
                        tooltip_title: "Audience Window";
                        shortcut: "Display";
                        tooltip_hint: "Open external audience projector display window";
                        clicked => { root.toggle_audience_window(); }

                        Image {
                            source: @image-url("icons/audience_window.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.audience_window_open ? root.active_color : #ffffff;
                        }
                    }

                    // Speaker Notes Drawer Button
                    PresenterHeaderBtn {
                        align_right: true;
                        is_active: root.notes_drawer_open;
                        active_bg: #2563eb;
                        active_border: #60a5fa;
                        tooltip_title: "Speaker Notes";
                        shortcut: "Notes";
                        tooltip_hint: "Toggle side panel with speaker notes & preview";
                        clicked => { root.notes_drawer_open = !root.notes_drawer_open; }

                        Image {
                            source: @image-url("icons/notes_drawer.svg");
                            width: 17px;
                            height: 17px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.notes_drawer_open ? root.active_color : #ffffff;
                        }
                    }

                    // Options & Updates Modal / More Menu
                    PresenterHeaderBtn {
                        align_right: true;
                        tooltip_title: "Options & Updates";
                        shortcut: "More";
                        tooltip_hint: "Check for updates, release notes, and export PDF";
                        clicked => { root.show_updates_modal = !root.show_updates_modal; }

                        Text {
                            text: "•••";
                            color: root.show_updates_modal ? #38bdf8 : #9ca3af;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Notification pill when an update is available on GitHub
                        if root.update_available_badge: Rectangle {
                            x: parent.width - 6px;
                            y: 2px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #38bdf8;
                        }
                    }
                }
            }
        }

        // --- Presenter SECONDARY ACTION BAR (Page Management Toolbar) ---
        if root.show_thumbnails: Rectangle {
            height: 38px;
            background: #18181c;
            border-width: 1px;
            border-color: #28282e;
            z: 90;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 18px;
                alignment: start;

                PresenterActionItem {
                    icon: "+";
                    label: "Insert";
                    clicked => { root.show_insert_page_modal = true; }
                }
                PresenterActionItem {
                    icon: "✂";
                    label: "Cut";
                    clicked => { root.delete_slide(root.current_slide); }
                }
                PresenterActionItem {
                    icon: "📑";
                    label: "Duplicate";
                    clicked => { root.duplicate_slide(root.current_slide); }
                }
                PresenterActionItem {
                    icon: "🔄";
                    label: "Rotate";
                    clicked => { root.rotate_slide(root.current_slide); }
                }
                PresenterActionItem {
                    icon: "🗑";
                    label: "Delete";
                    is_danger: true;
                    clicked => { root.delete_slide(root.current_slide); }
                }
            }
        }

        // --- MAIN WORKSPACE AREA ---
        main_workspace := Rectangle {
            vertical-stretch: 1;
            clip: true;

            property <length> drawer_w: root.notes_drawer_open 
                ? max(240px, min(self.width - 376px, (self.width - 56px) * root.notes_split_ratio)) 
                : 0px;

            // 1. Presenter LEFT SLIM TOOLBAR
            Rectangle {
                x: 0px;
                y: 0px;
                width: 50px;
                height: parent.height;
                background: #1c1c1f;
                border-width: 1px;
                border-color: #27272b;
                z: 50;

                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: start;

                    // 1. Grid / Thumbnails (4 squares)
                    PresenterIconBtn {
                        is_active: root.show_thumbnails;
                        tooltip_title: "Slide Grid Overview";
                        shortcut: "Tab";
                        tooltip_hint: "Toggle thumbnail grid drawer";
                        clicked => {
                            root.show_thumbnails = !root.show_thumbnails;
                        }
                        Image {
                            source: @image-url("icons/thumbnails.svg");
                            width: 20px;
                            height: 20px;
                            x: 9px;
                            y: 9px;
                            colorize: root.show_thumbnails ? root.active_color : #ffffff;
                        }
                    }

                    // 2. Fountain Pen (P)
                    PresenterIconBtn {
                        is_active: root.current_tool == ActiveTool.Pen;
                        tooltip_title: "Ballpoint & Fountain Pen";
                        shortcut: "P";
                        tooltip_hint: "Right-click to adjust thickness & style";
                        clicked => {
                            root.current_tool = ActiveTool.Pen;
                            root.tool_selected(ActiveTool.Pen);
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                            root.show_color_popover = false;
                        }
                        right_clicked => {
                            root.current_tool = ActiveTool.Pen;
                            root.tool_selected(ActiveTool.Pen);
                            root.show_pen_popover = !root.show_pen_popover;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                            root.show_color_popover = false;
                        }
                        Image {
                            source: @image-url("icons/pen.svg");
                            width: 22px;
                            height: 22px;
                            x: 8px;
                            y: 6px;
                            colorize: root.current_tool == ActiveTool.Pen ? root.active_color : #ffffff;
                        }
                        // Active elected color indicator bar
                        Rectangle {
                            x: 8px;
                            y: 31px;
                            width: 22px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: root.active_color;
                        }
                    }

                    // 3. Highlighter (H)
                    PresenterIconBtn {
                        is_active: root.current_tool == ActiveTool.Highlighter;
                        tooltip_title: "Translucent Highlighter";
                        shortcut: "H";
                        tooltip_hint: "Right-click for width & opacity presets";
                        clicked => {
                            root.current_tool = ActiveTool.Highlighter;
                            root.tool_selected(ActiveTool.Highlighter);
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                            root.show_color_popover = false;
                        }
                        right_clicked => {
                            root.current_tool = ActiveTool.Highlighter;
                            root.tool_selected(ActiveTool.Highlighter);
                            root.show_highlighter_popover = !root.show_highlighter_popover;
                            root.show_pen_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                            root.show_color_popover = false;
                        }
                        Image {
                            source: @image-url("icons/highlighter.svg");
                            width: 22px;
                            height: 22px;
                            x: 8px;
                            y: 6px;
                            colorize: root.current_tool == ActiveTool.Highlighter ? root.active_color : #ffffff;
                        }
                        // Active elected color indicator bar
                        Rectangle {
                            x: 8px;
                            y: 31px;
                            width: 22px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: root.active_color;
                        }
                    }

                    // 4. Eraser (E)
                    PresenterIconBtn {
                        is_active: root.current_tool == ActiveTool.Eraser;
                        tooltip_title: "Stroke & Precision Eraser";
                        shortcut: "E";
                        tooltip_hint: "Right-click to toggle Stroke vs Pixel mode";
                        clicked => {
                            root.current_tool = ActiveTool.Eraser;
                            root.tool_selected(ActiveTool.Eraser);
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                            root.show_color_popover = false;
                        }
                        right_clicked => {
                            root.current_tool = ActiveTool.Eraser;
                            root.tool_selected(ActiveTool.Eraser);
                            root.show_eraser_popover = !root.show_eraser_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_laser_popover = false;
                            root.show_color_popover = false;
                        }
                        Image {
                            source: @image-url("icons/eraser.svg");
                            width: 22px;
                            height: 22px;
                            x: 8px;
                            y: 8px;
                            colorize: root.current_tool == ActiveTool.Eraser ? root.active_color : #ffffff;
                        }
                    }

                    // 5. Presenter Tool / Laser Pointer (L) - SVG icon with dynamic laser dot
                    PresenterIconBtn {
                        is_active: root.current_tool == ActiveTool.Laser;
                        tooltip_title: "Laser Pointer & Spotlight";
                        shortcut: "L";
                        tooltip_hint: "Right-click to adjust fade duration (0–5s)";
                        clicked => {
                            root.current_tool = ActiveTool.Laser;
                            root.laser_color = root.active_color;
                            root.tool_selected(ActiveTool.Laser);
                            root.show_laser_popover = false;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_color_popover = false;
                        }
                        right_clicked => {
                            root.current_tool = ActiveTool.Laser;
                            root.laser_color = root.active_color;
                            root.tool_selected(ActiveTool.Laser);
                            root.show_laser_popover = !root.show_laser_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_color_popover = false;
                        }
                        Image {
                            source: @image-url("icons/laser.svg");
                            width: 22px;
                            height: 22px;
                            x: 8px;
                            y: 6px;
                            colorize: root.current_tool == ActiveTool.Laser ? root.active_color : #ffffff;
                        }
                        // Active elected color indicator bar
                        Rectangle {
                            x: 8px;
                            y: 31px;
                            width: 22px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: root.active_color;
                        }
                    }

                    // 6. Microphone (M)
                    PresenterIconBtn {
                        is_active: root.current_tool == ActiveTool.Mic || root.is_recording;
                        tooltip_title: "Audio Presentation Notes";
                        shortcut: "M";
                        tooltip_hint: "Record synchronized audio timestamps";
                        clicked => {
                            root.is_recording = !root.is_recording;
                            root.current_tool = ActiveTool.Mic;
                            root.tool_selected(ActiveTool.Mic);
                        }
                        Image {
                            source: @image-url("icons/mic.svg");
                            width: 20px;
                            height: 20px;
                            x: 9px;
                            y: 9px;
                            colorize: root.is_recording ? #ef4444 : (root.current_tool == ActiveTool.Mic ? root.active_color : #ffffff);
                        }
                    }

                    // 10. Add Page / Whiteboard (N / +)
                    PresenterIconBtn {
                        is_active: root.show_insert_page_modal;
                        tooltip_title: "Insert Blank Page / Whiteboard";
                        shortcut: "N";
                        tooltip_hint: "Insert blank, lined, or grid whiteboard page";
                        clicked => { root.show_insert_page_modal = !root.show_insert_page_modal; }
                        Image {
                            source: @image-url("icons/add_page.svg");
                            width: 20px;
                            height: 20px;
                            x: 9px;
                            y: 9px;
                            colorize: root.show_insert_page_modal ? root.active_color : #ffffff;
                        }
                    }

                    // 11. Undo
                    PresenterIconBtn {
                        tooltip_title: "Undo Action";
                        shortcut: "⌘Z";
                        tooltip_hint: "Revert the last stroke or action";
                        clicked => { root.undo(); }
                        Image {
                            source: @image-url("icons/undo.svg");
                            width: 20px;
                            height: 20px;
                            x: 9px;
                            y: 9px;
                            colorize: #ffffff;
                        }
                    }

                    // 12. Redo
                    PresenterIconBtn {
                        tooltip_title: "Redo Action";
                        shortcut: "⇧⌘Z";
                        tooltip_hint: "Re-apply reverted stroke or action";
                        clicked => { root.redo(); }
                        Image {
                            source: @image-url("icons/redo.svg");
                            width: 20px;
                            height: 20px;
                            x: 9px;
                            y: 9px;
                            colorize: #ffffff;
                        }
                    }

                    // 13. Quick Color Slot 1 (Yellow)
                    PresenterColorSlot {
                        slot_color: root.color_slot_1;
                        is_active: root.active_color_slot == 0;
                        is_popover_open: root.show_color_popover;
                        slot_label: "Color Slot 1";
                        shortcut: "1";
                        clicked => {
                            root.active_color_slot = 0;
                            root.active_color = root.color_slot_1;
                            root.color_changed(root.color_slot_1);
                            root.show_color_popover = false;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                        right_clicked => {
                            root.active_color_slot = 0;
                            root.active_color = root.color_slot_1;
                            root.color_changed(root.color_slot_1);
                            root.show_color_popover = !root.show_color_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                    }

                    // 14. Quick Color Slot 2 (Green)
                    PresenterColorSlot {
                        slot_color: root.color_slot_2;
                        is_active: root.active_color_slot == 1;
                        is_popover_open: root.show_color_popover;
                        slot_label: "Color Slot 2";
                        shortcut: "2";
                        clicked => {
                            root.active_color_slot = 1;
                            root.active_color = root.color_slot_2;
                            root.color_changed(root.color_slot_2);
                            root.show_color_popover = false;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                        right_clicked => {
                            root.active_color_slot = 1;
                            root.active_color = root.color_slot_2;
                            root.color_changed(root.color_slot_2);
                            root.show_color_popover = !root.show_color_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                    }

                    // 15. Quick Color Slot 3 (Purple)
                    PresenterColorSlot {
                        slot_color: root.color_slot_3;
                        is_active: root.active_color_slot == 2;
                        is_popover_open: root.show_color_popover;
                        slot_label: "Color Slot 3";
                        shortcut: "3";
                        clicked => {
                            root.active_color_slot = 2;
                            root.active_color = root.color_slot_3;
                            root.color_changed(root.color_slot_3);
                            root.show_color_popover = false;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                        right_clicked => {
                            root.active_color_slot = 2;
                            root.active_color = root.color_slot_3;
                            root.color_changed(root.color_slot_3);
                            root.show_color_popover = !root.show_color_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                    }

                    // 16. Quick Color Slot 4 (Coral Red)
                    PresenterColorSlot {
                        slot_color: root.color_slot_4;
                        is_active: root.active_color_slot == 3;
                        is_popover_open: root.show_color_popover;
                        slot_label: "Color Slot 4";
                        shortcut: "4";
                        clicked => {
                            root.active_color_slot = 3;
                            root.active_color = root.color_slot_4;
                            root.color_changed(root.color_slot_4);
                            root.show_color_popover = false;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                        right_clicked => {
                            root.active_color_slot = 3;
                            root.active_color = root.color_slot_4;
                            root.color_changed(root.color_slot_4);
                            root.show_color_popover = !root.show_color_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                    }

                    // 17. Quick Color Slot 5 (Sky Blue)
                    PresenterColorSlot {
                        slot_color: root.color_slot_5;
                        is_active: root.active_color_slot == 4;
                        is_popover_open: root.show_color_popover;
                        slot_label: "Color Slot 5";
                        shortcut: "5";
                        clicked => {
                            root.active_color_slot = 4;
                            root.active_color = root.color_slot_5;
                            root.color_changed(root.color_slot_5);
                            root.show_color_popover = false;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                        right_clicked => {
                            root.active_color_slot = 4;
                            root.active_color = root.color_slot_5;
                            root.color_changed(root.color_slot_5);
                            root.show_color_popover = !root.show_color_popover;
                            root.show_pen_popover = false;
                            root.show_highlighter_popover = false;
                            root.show_eraser_popover = false;
                            root.show_laser_popover = false;
                        }
                    }
                }
            }

            // 2. MAIN CENTER VIEWPORT: Presenter PAGE OVERVIEW GRID (when show_thumbnails is true)
            if root.show_thumbnails: Rectangle {
                x: 50px;
                y: 0px;
                width: parent.width - 50px;
                height: parent.height;
                background: #000000;
                clip: true;

                ScrollView {
                    width: 100%;
                    height: 100%;

                    overview_canvas := Rectangle {
                        property <length> min_margin: 28px;
                        property <length> spacing_x: 24px;
                        property <length> spacing_y: 28px;
                        property <length> badge_h: 36px;
                        property <length> card_w: root.slide_aspect > 1.2 
                            ? min(220px, max(120px, self.width - 2 * self.min_margin)) 
                            : min(160px, max(100px, self.width - 2 * self.min_margin));
                        property <length> card_h: root.slide_aspect > 1.2 ? (self.card_w / max(0.4, root.slide_aspect)) : (self.card_w / max(0.4, root.slide_aspect));
                        property <length> item_h: self.card_h + self.badge_h;

                        property <int> cols: max(1, Math.floor((self.width / 1px - 2 * 28 + 24) / ((self.card_w / 1px) + 24)));
                        property <int> rows: max(1, (root.total_slides + self.cols - 1) / max(1, self.cols));

                        property <length> total_grid_w: self.cols * self.card_w + max(0, self.cols - 1) * self.spacing_x;
                        property <length> auto_margin_x: max(0px, (self.width - self.total_grid_w) / 2);

                        width: 100%;
                        height: max(parent.height, 56px + (self.rows * (self.item_h + self.spacing_y)));

                        for thumb[i] in root.slide_thumbnails: card_item := Rectangle {
                            property <int> grid_row: Math.floor(i / overview_canvas.cols);
                            property <int> grid_col: i - self.grid_row * overview_canvas.cols;

                            x: overview_canvas.auto_margin_x + self.grid_col * (overview_canvas.card_w + overview_canvas.spacing_x);
                            y: 32px + self.grid_row * (overview_canvas.item_h + overview_canvas.spacing_y);
                            width: overview_canvas.card_w;
                            height: overview_canvas.item_h;

                            // Slot Container with Drop Target Indicator
                            card_slot := Rectangle {
                                width: overview_canvas.card_w;
                                height: overview_canvas.card_h;
                                y: 0px;

                                // Drop Target Insertion Glow & Indicator
                                if root.is_dragging_page && root.drag_target_index == thumb.index && root.dragging_page_index != thumb.index: Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: 6px;
                                    border-width: 2.5px;
                                    border-color: #38bdf8;
                                    background: #0284c733;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #38bdf888;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Text {
                                            text: "⬇";
                                            color: #38bdf8;
                                            font-size: 22px;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "Drop Here";
                                            color: #38bdf8;
                                            font-size: 13px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                // Thumbnail Card
                                page_card := Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: (root.is_dragging_page && root.dragging_page_index == thumb.index) ? #18181b : #ffffff;
                                    border-radius: 4px;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #000000cc;
                                    border-width: (thumb.index == root.current_slide) ? 2.5px : 1px;
                                    border-color: (thumb.index == root.current_slide) ? #007aff : (card_touch.has-hover ? #4b5563 : #27272a);
                                    opacity: (root.is_dragging_page && root.dragging_page_index == thumb.index) ? 0.30 : (root.is_dragging_page ? 0.65 : 1.0);
                                    clip: true;

                                    // Slide Content Image
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: thumb.image;
                                        image-fit: contain;
                                    }

                                    // Source slot ghost label while being dragged
                                    if root.is_dragging_page && root.dragging_page_index == thumb.index: Rectangle {
                                        background: #09090bcc;
                                        Text {
                                            text: "Moving Slide " + thumb.index;
                                            color: #a1a1aa;
                                            font-size: 12px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Blue Zoom/Inspect Badge on Top-Left matching Presenter exactly
                                    if thumb.index == root.current_slide && !root.is_dragging_page: Rectangle {
                                        x: 6px;
                                        y: 6px;
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: #007aff;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #00000066;

                                        Text {
                                            text: "🔍";
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Interactive Drag & Click TouchArea
                                card_touch := TouchArea {
                                    mouse-cursor: self.pressed ? grabbing : grab;

                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.drag_start_mouse_x = self.mouse-x;
                                            root.drag_start_mouse_y = self.mouse-y;
                                            root.dragging_page_index = thumb.index;
                                            root.drag_target_index = thumb.index;
                                            root.dragging_slide_image = thumb.image;
                                            root.drag_offset_x = 0px;
                                            root.drag_offset_y = 0px;
                                            root.is_dragging_page = false;
                                        } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                            if root.dragging_page_index == thumb.index {
                                                let did_drag = root.is_dragging_page;
                                                let from_idx = root.dragging_page_index;
                                                let to_idx = root.drag_target_index;

                                                root.is_dragging_page = false;
                                                root.dragging_page_index = 0;
                                                root.drag_target_index = 0;
                                                root.drag_offset_x = 0px;
                                                root.drag_offset_y = 0px;

                                                if did_drag {
                                                    if to_idx != from_idx && to_idx >= 1 && to_idx <= root.total_slides {
                                                        root.move_slide(from_idx, to_idx);
                                                    }
                                                } else {
                                                    if root.current_slide == thumb.index {
                                                        root.show_thumbnails = false;
                                                    } else {
                                                        root.current_slide = thumb.index;
                                                        root.jump_to_slide(thumb.index);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    moved => {
                                        if self.pressed && root.dragging_page_index == thumb.index {
                                            let dx = self.mouse-x - root.drag_start_mouse_x;
                                            let dy = self.mouse-y - root.drag_start_mouse_y;
                                            root.drag_offset_x = dx;
                                            root.drag_offset_y = dy;

                                            if !root.is_dragging_page && (dx > 8px || dx < -8px || dy > 8px || dy < -8px) {
                                                root.is_dragging_page = true;
                                            }

                                            if root.is_dragging_page {
                                                let step_x = overview_canvas.card_w + overview_canvas.spacing_x;
                                                let step_y = overview_canvas.item_h + overview_canvas.spacing_y;
                                                let col_delta = Math.round((dx / 1px) / (step_x / 1px));
                                                let row_delta = Math.round((dy / 1px) / (step_y / 1px));
                                                let target = max(1, min(root.total_slides, thumb.index + row_delta * overview_canvas.cols + col_delta));
                                                root.drag_target_index = target;
                                            }
                                        }
                                    }
                                }
                            }

                            // Centered Page Number & Drag Handle Badge below Card
                            Rectangle {
                                y: overview_canvas.card_h + 8px;
                                height: 28px;
                                min-width: 56px;
                                x: (parent.width - self.width) / 2;
                                border-radius: 6px;
                                background: (thumb.index == root.current_slide) ? #007aff : (card_touch.has-hover ? #2e2e34 : #1f1f23);
                                border-width: 1px;
                                border-color: (thumb.index == root.current_slide) ? #60a5fa : ((root.is_dragging_page && root.drag_target_index == thumb.index) ? #38bdf8 : #2e2e34);

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: "⠿";
                                        color: (thumb.index == root.current_slide) ? #ffffffcc : #71717a;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: thumb.index;
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Floating Elevated Dragged Card Preview (rendered on top of all cards)
                        if root.is_dragging_page: Rectangle {
                            property <int> orig_i: root.dragging_page_index - 1;
                            property <int> orig_row: Math.floor(self.orig_i / overview_canvas.cols);
                            property <int> orig_col: self.orig_i - self.orig_row * overview_canvas.cols;

                            x: overview_canvas.auto_margin_x + self.orig_col * (overview_canvas.card_w + overview_canvas.spacing_x) + root.drag_offset_x;
                            y: 32px + self.orig_row * (overview_canvas.item_h + overview_canvas.spacing_y) + root.drag_offset_y;
                            width: overview_canvas.card_w;
                            height: overview_canvas.card_h;
                            background: #ffffff;
                            border-radius: 6px;
                            border-width: 2.5px;
                            border-color: #38bdf8;
                            drop-shadow-blur: 28px;
                            drop-shadow-color: #007affcc;
                            opacity: 0.95;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.dragging_slide_image;
                                image-fit: contain;
                            }

                            // Dynamic target indicator pill on the dragged card
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 10px;
                                height: 26px;
                                border-radius: 13px;
                                background: #0284c7f2;
                                drop-shadow-blur: 8px;
                                drop-shadow-color: #00000088;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;

                                    Text {
                                        text: "Slide " + root.dragging_page_index + " ➔ " + root.drag_target_index;
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 3. REGULAR PRESENTATION SLIDE VIEWPORT (when show_thumbnails is false)
            if !root.show_thumbnails: canvas_area := Rectangle {
                x: 50px;
                y: 0px;
                width: parent.width - 50px - (root.notes_drawer_open ? (main_workspace.drawer_w + 6px) : 0px);
                height: parent.height;
                background: #141416;
                clip: true;

                property <length> avail_w: max(100px, self.width > 48px ? self.width - 48px : 100px);
                property <length> avail_h: max(100px, (self.height - (root.current_has_media ? 52px : 0px) > 48px) ? (self.height - (root.current_has_media ? 52px : 0px) - 48px) : 100px);
                property <float> aspect: root.slide_aspect > 0.1 ? root.slide_aspect : 1.7778;
                property <length> paper_w: (self.avail_w / 1px) / (self.avail_h / 1px) > self.aspect
                    ? (self.avail_h * self.aspect)
                    : self.avail_w;
                property <length> paper_h: (self.avail_w / 1px) / (self.avail_h / 1px) > self.aspect
                    ? self.avail_h
                    : (self.avail_w / self.aspect);

                // Document Page (Centered white paper with drop shadow matching Presenter)
                paper_box := Rectangle {
                    width: canvas_area.paper_w;
                    height: canvas_area.paper_h;
                    x: max(0px, (parent.width - self.width) / 2);
                    y: max(0px, (parent.height - (root.current_has_media ? 52px : 0px) - self.height) / 2);
                    background: #ffffff;
                    border-radius: 4px;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000088;
                    clip: true;

                    // Rendered PDF Page
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.current_slide_image;
                        image-fit: fill;
                    }

                    // In-Place Embedded Video Player Layer (Native, identical size, no external window)
                    if root.current_has_media && root.media_video_visible: Rectangle {
                        x: root.media_rect_x * parent.width;
                        y: root.media_rect_y * parent.height;
                        width: root.media_rect_w * parent.width;
                        height: root.media_rect_h * parent.height;
                        background: #000000;
                        border-radius: 0px;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.video_frame_image;
                            image-fit: fill;
                        }
                    }

                    // Outline of the clip the toolbar drives, when the slide has several
                    if root.current_has_media && root.media_clip_count > 1 && !root.media_video_visible: Rectangle {
                        x: root.media_rect_x * parent.width;
                        y: root.media_rect_y * parent.height;
                        width: root.media_rect_w * parent.width;
                        height: root.media_rect_h * parent.height;
                        border-width: 2px;
                        border-color: #ff3b30;
                        background: transparent;
                    }

                    // Vector Inking Overlay
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.ink_overlay_image;
                        image-fit: fill;
                    }

                    LaserVectorTrail {
                        width: 100%;
                        height: 100%;
                        bands: root.laser_bands;
                        trail-color: root.laser_color;
                    }

                    if root.laser_layer_visible: Image {
                        x: root.laser_layer_x * parent.width;
                        y: root.laser_layer_y * parent.height;
                        width: root.laser_layer_w * parent.width;
                        height: root.laser_layer_h * parent.height;
                        source: root.laser_layer_image;
                        image-fit: fill;
                    }

                    // Laser pointer dot & glow (Multi-layer neon bloom with hot core)
                    if root.laser_active: Rectangle {
                        width: 32px;
                        height: 32px;
                        x: (root.laser_x * parent.width) - 16px;
                        y: (root.laser_y * parent.height) - 16px;

                        // 1. Broad atmospheric neon aura
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.laser_color.transparentize(0.82);
                        }
                        // 2. Concentrated saturated corona
                        Rectangle {
                            x: 6px;
                            y: 6px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: root.laser_color.transparentize(0.35);
                        }
                        // 3. Dense core dot
                        Rectangle {
                            x: 10px;
                            y: 10px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.laser_color;
                        }
                        // 4. White-hot filament center
                        Rectangle {
                            x: 14px;
                            y: 14px;
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: #ffffff;
                        }
                    }

                    // Eraser cursor circle indicator
                    if root.current_tool == ActiveTool.Eraser && touch_canvas.has-hover: Rectangle {
                        width: 28px;
                        height: 28px;
                        x: (root.laser_x * parent.width) - 14px;
                        y: (root.laser_y * parent.height) - 14px;
                        border-radius: 14px;
                        border-width: 1.5px;
                        border-color: #f43f5ecc;
                        background: #f43f5e26;
                    }

                    // End of Slide Show Black Screen Overlay
                    if root.is_end_of_show: Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #09090b;
                        border-radius: 4px;
                        clip: true;

                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 26px;
                                background: #ffffff14;
                                x: (parent.width - self.width) / 2;

                                Text {
                                    text: "◼";
                                    color: #f4f4f5;
                                    font-size: 22px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "End of Slide Show";
                                color: #ffffff;
                                font-size: 24px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Audience screen is blacked out. Press ◀ or Backspace to return to slides.";
                                color: #9ca3af;
                                font-size: 13px;
                                font-weight: 500;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.prev_slide(); }
                        }
                    }

                    // Interactive touch area for drawing / laser / eraser
                    touch_canvas := TouchArea {
                        mouse-cursor: root.hovered_on_link ? MouseCursor.pointer : (
                            (root.current_tool == ActiveTool.Pen || root.current_tool == ActiveTool.Highlighter || root.current_tool == ActiveTool.Eraser || root.current_tool == ActiveTool.Laser) ? MouseCursor.none :
                            MouseCursor.crosshair
                        );
                        pointer-event(event) => {
                            let norm_x = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                            let norm_y = max(0.0, min(1.0, (self.mouse-y / 1px) / (self.height / 1px)));
                            root.laser_x = norm_x;
                            root.laser_y = norm_y;
                            if (event.kind == PointerEventKind.down) {
                                root.show_color_popover = false;
                                root.show_pen_popover = false;
                                root.show_highlighter_popover = false;
                                root.show_eraser_popover = false;
                                root.show_laser_popover = false;
                                if (root.current_tool == ActiveTool.Laser) {
                                    root.laser_active = true;
                                }
                                root.canvas_pointer_down(norm_x, norm_y, 1.0);
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                if (root.current_tool == ActiveTool.Laser) {
                                    root.laser_active = false;
                                }
                                root.canvas_pointer_up();
                            }
                        }
                        moved => {
                            let norm_x = max(0.0, min(1.0, (self.mouse-x / 1px) / (self.width / 1px)));
                            let norm_y = max(0.0, min(1.0, (self.mouse-y / 1px) / (self.height / 1px)));
                            root.laser_x = norm_x;
                            root.laser_y = norm_y;
                            root.canvas_pointer_move(norm_x, norm_y, self.pressed ? 1.0 : 0.0);
                        }
                    }

                    // In-canvas custom tool-shaped cursor matching selected tool
                    if touch_canvas.has-hover && !root.hovered_on_link: Rectangle {
                        x: touch_canvas.mouse-x - (root.current_tool == ActiveTool.Eraser ? 12px : (root.current_tool == ActiveTool.Laser ? 7px : 2px));
                        y: touch_canvas.mouse-y - (root.current_tool == ActiveTool.Eraser ? 12px : (root.current_tool == ActiveTool.Laser ? 7px : 2px));
                        width: 24px;
                        height: 24px;
                        clip: false;

                        if root.current_tool == ActiveTool.Pen: Rectangle {
                            width: 24px;
                            height: 24px;
                            Image {
                                source: @image-url("icons/pen_cursor.svg");
                                width: 24px;
                                height: 24px;
                            }
                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: 3px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: root.active_color;
                            }
                        }
                        if root.current_tool == ActiveTool.Highlighter: Rectangle {
                            width: 24px;
                            height: 24px;
                            Image {
                                source: @image-url("icons/highlighter_cursor.svg");
                                width: 24px;
                                height: 24px;
                            }
                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: 3px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: root.active_color;
                            }
                        }
                        if root.current_tool == ActiveTool.Eraser: Image {
                            source: @image-url("icons/eraser_cursor.svg");
                            width: 24px;
                            height: 24px;
                        }

                        if root.current_tool == ActiveTool.Laser && !root.laser_active: Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: root.laser_color.transparentize(0.3);
                            drop-shadow-blur: 8px;
                            drop-shadow-color: root.laser_color;
                            Rectangle {
                                x: 4px;
                                y: 4px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #ffffff;
                            }
                        }
                    }

                    // Pulse ring around touch point during link hold
                    if root.link_holding: Rectangle {
                        x: (root.laser_x * parent.width) - 24px;
                        y: (root.laser_y * parent.height) - 24px;
                        width: 48px;
                        height: 48px;
                        border-radius: 24px;
                        border-width: 2.5px;
                        border-color: #38bdf8cc;
                        background: #38bdf826;
                    }

                    // Link Tooltip / Hold Progress Pill
                    if (root.hovered_on_link || root.link_holding) && root.hovered_link_tooltip != "": Rectangle {
                        x: max(16px, min(parent.width - self.width - 16px, (root.laser_x * parent.width) - (self.width / 2)));
                        y: (root.laser_y * parent.height) > 60px ? (root.laser_y * parent.height) - 46px : (root.laser_y * parent.height) + 20px;
                        height: 34px;
                        background: #18181be6;
                        border-radius: 17px;
                        border-width: 1.5px;
                        border-color: root.link_holding ? #38bdf8 : #38bdf888;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000088;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;
                            
                            Text {
                                text: root.link_holding ? "⏳" : "🔗";
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.link_holding 
                                    ? (root.link_hold_progress >= 1.0 ? "Opening..." : "Hold to open link...")
                                    : root.hovered_link_tooltip;
                                color: #f1f5f9;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Progress bar inside pill when holding
                        if root.link_holding: Rectangle {
                            x: 0px;
                            y: parent.height - 3px;
                            width: parent.width * max(0.0, min(1.0, root.link_hold_progress));
                            height: 3px;
                            border-bottom-left-radius: 17px;
                            border-bottom-right-radius: (root.link_hold_progress >= 0.95 ? 17px : 0px);
                            background: #38bdf8;
                        }
                    }
                }



                // BOTTOM RIGHT FLOATING QUICK ZOOM / CONTROLS (from Presenter screenshot)
                Rectangle {
                    width: 38px;
                    height: 38px;
                    x: parent.width - 54px;
                    y: parent.height - 54px;
                    border-radius: 19px;
                    background: #202023;
                    border-width: 1px;
                    border-color: #2e2e34;

                    Text {
                        text: "🔍";
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            // Cycle quality / zoom
                            if (root.render_quality == "Ultra Vector (600 DPI)") {
                                root.render_quality = "Balanced (300 DPI)";
                            } else {
                                root.render_quality = "Ultra Vector (600 DPI)";
                            }
                            root.quality_changed(root.render_quality);
                        }
                    }
                }

                // Click-outside backdrop: intercepts clicks anywhere outside any open popover to close it safely without drawing ink
                if (root.show_color_popover || root.show_pen_popover || root.show_highlighter_popover || root.show_eraser_popover || root.show_laser_popover): TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.show_color_popover = false;
                        root.show_pen_popover = false;
                        root.show_highlighter_popover = false;
                        root.show_eraser_popover = false;
                        root.show_laser_popover = false;
                    }
                }

                // --- Presenter FLOATING COLOR POPOVER (Exact from Screenshot) ---
                if root.show_color_popover: Rectangle {
                    width: 290px;
                    height: 400px;
                    x: 52px;
                    y: max(40px, min(root.height - 420px, 310px + (root.active_color_slot * 42px)));
                    background: #1c1c1e;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: #2c2c30;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000dd;

                    // Intercept clicks inside popover so clicking empty padding doesn't dismiss
                    TouchArea { }

                    // Left beak pointer pointing dynamically to whichever color slot is active on toolbar
                    Path {
                        x: -8px;
                        y: 193px;
                        width: 8px;
                        height: 14px;
                        fill: #1c1c1e;
                        commands: "M 8 0 L 0 7 L 8 14 Z";
                    }

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 12px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        // Header with Title and Done button
                        HorizontalLayout {
                            alignment: space-between;

                            // Left spacer to keep "Color" centered
                            Rectangle { width: 48px; height: 1px; }

                            Text {
                                text: "Color";
                                font-size: 16px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            // Done button to close color selector window
                            Rectangle {
                                width: 48px;
                                height: 26px;
                                border-radius: 6px;
                                background: btn_color_done.has-hover ? #2563eb33 : #27272a;
                                border-width: 1px;
                                border-color: btn_color_done.has-hover ? #3b82f6 : #3f3f46;

                                Text {
                                    text: "Done";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: btn_color_done.has-hover ? #60a5fa : #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                btn_color_done := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show_color_popover = false;
                                    }
                                }
                            }
                        }

                        // Tab 0: Grid (12 cols x 9 rows full spectrum with white selection square)
                        if root.color_tab_index == 0: Rectangle {
                            height: 180px;
